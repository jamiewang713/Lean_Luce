structure Luce.Weights (n : ℕ) : Type
number of parameters: 1
fields:
  Luce.Weights.rate : Fin n → ℝ
  Luce.Weights.positive : ∀ (i : Fin n), 0 < self.rate i
constructor:
  Luce.Weights.mk {n : ℕ} (rate : Fin n → ℝ) (positive : ∀ (i : Fin n), 0 < rate i) : Luce.Weights n
@[reducible] def Luce.WeightArray : Type :=
(n : ℕ) → Luce.Weights n
def Luce.NormalizedWeights : Luce.WeightArray → Prop :=
fun w => ∀ (n : ℕ), 0 < n → 1 / ↑n * ∑ i, (w n).rate i = 1
def Luce.ProfileLimit : Luce.WeightArray → (ℝ → ℝ) → Prop :=
fun w f =>
  MeasureTheory.NullMeasurable f Luce.profileMeasure ∧ (∀ x ∈ Set.Ioo 0 1, 0 < f x) ∧ Luce.ProfileL1Convergence w f
def Luce.ProfileL1Convergence : Luce.WeightArray → (ℝ → ℝ) → Prop :=
fun w f =>
  Filter.Tendsto (fun n => MeasureTheory.eLpNorm (fun x => Luce.stepProfile w n x - f x) 1 Luce.profileMeasure)
    Filter.atTop (nhds 0)
def Luce.stepProfile : Luce.WeightArray → ℕ → ℝ → ℝ :=
fun w n x => ∑ i, if ↑↑i / ↑n < x ∧ x ≤ (↑↑i + 1) / ↑n then (w n).rate i else 0
def Luce.profileMeasure : MeasureTheory.Measure ℝ :=
MeasureTheory.volume.restrict (Set.Ioo 0 1)
def Luce.profileF.{u_1} : {Ω : Type u_1} → [inst : MeasurableSpace Ω] → MeasureTheory.Measure Ω → (Ω → ℝ) → ℝ → ℝ :=
fun {Ω} [MeasurableSpace Ω] μ f t => 1 - Luce.profileH μ f t
def Luce.profileH.{u_1} : {Ω : Type u_1} → [inst : MeasurableSpace Ω] → MeasureTheory.Measure Ω → (Ω → ℝ) → ℝ → ℝ :=
fun {Ω} [MeasurableSpace Ω] μ f t => ∫ (x : Ω), Luce.survivalKernel t (f x) ∂μ
def Luce.profileD.{u_1} : {Ω : Type u_1} → [inst : MeasurableSpace Ω] → MeasureTheory.Measure Ω → (Ω → ℝ) → ℝ → ℝ :=
fun {Ω} [MeasurableSpace Ω] μ f t => ∫ (x : Ω), Luce.rateKernel t (f x) ∂μ
def Luce.rateKernel : ℝ → ℝ → ℝ :=
fun t a => a * Luce.survivalKernel t a
def Luce.survivalKernel : ℝ → ℝ → ℝ :=
fun t a => Real.exp (-t * a)
def Luce.profileQuantile.{u_1} : {Ω : Type u_1} →
  [inst : MeasurableSpace Ω] → MeasureTheory.Measure Ω → (Ω → ℝ) → ℝ → ℝ :=
fun {Ω} [MeasurableSpace Ω] μ f x => Function.invFunOn (Luce.profileF μ f) (Set.Ici 0) x
def Luce.profileDiagonal : (ℝ → ℝ) → ℝ → ℝ :=
fun f x =>
  Luce.rateKernel (Luce.profileQuantile Luce.profileMeasure f x) (f x) /
    Luce.profileD Luce.profileMeasure f (Luce.profileQuantile Luce.profileMeasure f x)
def Luce.empiricalArrival : {n : ℕ} → (Fin n → ℝ) → ℝ → ℝ :=
fun {n} clocks t => (∑ i, Luce.arrivalAt t (clocks i)) / ↑n
def Luce.empiricalRemainingGe : {n : ℕ} → Luce.Weights n → (Fin n → ℝ) → ℝ → ℝ :=
fun {n} w clocks t => (∑ i, if t ≤ clocks i then w.rate i else 0) / ↑n
def Luce.orderTime : {n : ℕ} → (Fin n → ℝ) → Fin n → ℝ :=
fun {n} clocks k => if h : Function.Injective clocks then Luce.arrivalTime clocks h k else 0
def Luce.arrivalTime : {n : ℕ} → (times : Fin n → ℝ) → Function.Injective times → Fin n → ℝ :=
fun {n} times hinj k => times ((Luce.drawPermutation times hinj) k)
def Luce.drawPermutation : {n : ℕ} → (times : Fin n → ℝ) → Function.Injective times → Equiv.Perm (Fin n) :=
fun {n} times hinj => Equiv.symm (Luce.rankPermutation times hinj)
def Luce.rankPermutation : {n : ℕ} → (times : Fin n → ℝ) → Function.Injective times → Equiv.Perm (Fin n) :=
fun {n} times hinj => Equiv.ofBijective (Luce.clockRank times) ⋯
def Luce.clockRank : {n : ℕ} → (Fin n → ℝ) → Fin n → Fin n :=
fun {n} times i => ⟨{j | times j < times i}.card, ⋯⟩
def Luce.raceDraw : {n : ℕ} → (Fin n → ℝ) → Equiv.Perm (Fin n) :=
fun {n} clocks => if h : Function.Injective clocks then Luce.drawPermutation clocks h else Equiv.refl (Fin n)
def Luce.Weights.mass : {n : ℕ} → Luce.Weights n → Equiv.Perm (Fin n) → ℝ :=
fun {n} w π => ∏ r, w.rate (π r) / ∑ j with r ≤ j, w.rate (π j)
def Luce.Weights.total : {n : ℕ} → Luce.Weights n → Finset (Fin n) → ℝ :=
fun {n} w s => ∑ i ∈ s, w.rate i
def Luce.Weights.choice : {n : ℕ} → Luce.Weights n → Finset (Fin n) → Fin n → ℝ :=
fun {n} w s i => if i ∈ s then w.rate i / w.total s else 0
def Luce.remaining : {n : ℕ} → Equiv.Perm (Fin n) → Fin n → Finset (Fin n) :=
fun {n} π k => {i | k ≤ (Equiv.symm π) i}
def Luce.predictableChance : {n : ℕ} → Luce.Weights n → Equiv.Perm (Fin n) → Fin n → ℝ :=
fun {n} w π k => w.choice (Luce.remaining π k) k
def Luce.interiorCompensatorSum : {n : ℕ} → Luce.Weights n → (ℝ → ℝ) → ℝ → (Fin n → ℝ) → ℝ :=
fun {n} w g α E =>
  ∑ i, if (↑↑i + 1) / ↑n ≤ α then g ((↑↑i + 1) / ↑n) * Luce.predictableChance w (Luce.raceDraw E) i else 0
def Luce.luceInteriorCompensatorSum : {n : ℕ} → Luce.Weights n → (ℝ → ℝ) → ℝ → Equiv.Perm (Fin n) → ℝ :=
fun {n} w g α π => ∑ k, if (↑↑k + 1) / ↑n ≤ α then g ((↑↑k + 1) / ↑n) * Luce.predictableChance w π k else 0
def Luce.intervalTestExtension : (α : ℝ) → (↑(Set.Icc 0 α) → ℝ) → ℝ → ℝ :=
fun α g x => if hx : x ∈ Set.Icc 0 α then g ⟨x, hx⟩ else 0
def Luce.ConvergesInProbability.{u_1} : {Ω : ℕ → Type u_1} →
  [inst : (n : ℕ) → MeasurableSpace (Ω n)] → ((n : ℕ) → MeasureTheory.Measure (Ω n)) → ((n : ℕ) → Ω n → ℝ) → ℝ → Prop :=
fun {Ω} [(n : ℕ) → MeasurableSpace (Ω n)] μ X c =>
  ∀ (ε : ℝ), 0 < ε → Filter.Tendsto (fun n => (μ n).real {ω | ε < |X n ω - c|}) Filter.atTop (nhds 0)
def Luce.section3Location : (n : ℕ) → Fin n → ↑(Set.Icc 0 1) :=
fun n k => ⟨(↑↑k + 1) / ↑n, ⋯⟩
def Luce.interiorFixedPoints : {n : ℕ} → ℝ → Equiv.Perm (Fin n) → Luce.FinitePointMeasure ↑(Set.Icc 0 1) :=
fun {n} α π =>
  Luce.observedPointMeasure (Luce.section3Location n) fun k => decide ((↑↑k + 1) / ↑n ≤ α ∧ (Equiv.symm π) k = k)
def Luce.observedPointMeasure.{u_1} : {X : Type u_1} →
  [inst : MeasurableSpace X] → {n : ℕ} → (Fin n → X) → (Fin n → Bool) → Luce.FinitePointMeasure X :=
fun {X} [MeasurableSpace X] {n} x b =>
  have s := {k | b k = true};
  Luce.FinitePointMeasure.ofFin fun j => x ↑(s.equivFin.symm j)
def Luce.interiorDensityMeasure : (ℝ → ℝ) → ℝ → MeasureTheory.Measure ℝ :=
fun f α => (MeasureTheory.volume.restrict (Set.Ioc 0 α)).withDensity fun x => ENNReal.ofReal (Luce.profileDiagonal f x)
def Luce.interiorIntensity : (w : Luce.WeightArray) →
  (f : ℝ → ℝ) → Luce.ProfileLimit w f → (α : ℝ) → α < 1 → MeasureTheory.FiniteMeasure ↑(Set.Icc 0 1) :=
fun w f hf α hα =>
  MeasureTheory.FiniteMeasure.map ⟨Luce.interiorDensityMeasure f α, ⋯⟩ (Set.projIcc 0 1 Luce.interiorIntensity._proof_1)
def Luce.FinitePointMeasure.{u_2} : (X : Type u_2) → [MeasurableSpace X] → Type (max 0 u_2) :=
fun X [MeasurableSpace X] => { μ // ∃ m x, Luce.pointMeasureOfFin x = μ }
def Luce.pointMeasureOfFin.{u_1} : {X : Type u_1} →
  [inst : MeasurableSpace X] → {m : ℕ} → (Fin m → X) → MeasureTheory.FiniteMeasure X :=
fun {X} [MeasurableSpace X] {m} x => ∑ i, (MeasureTheory.diracProba (x i)).toFiniteMeasure
def Luce.FinitePointMeasure.count.{u_1} : {X : Type u_1} →
  [inst : MeasurableSpace X] → Luce.FinitePointMeasure X → Set X → ℕ :=
fun {X} [MeasurableSpace X] μ B => ⌊↑(μ.toFiniteMeasure B)⌋₊
def Luce.finitePoissonLaw.{u_1} : {X : Type u_1} →
  [inst : MeasurableSpace X] → MeasureTheory.FiniteMeasure X → MeasureTheory.Measure (Luce.FinitePointMeasure X) :=
fun {X} [MeasurableSpace X] ν =>
  if hν : ν = 0 then MeasureTheory.Measure.dirac 0 else Luce.poissonMixture ν.mass (Luce.iidPointLaw ν.normalize)
def Luce.iidPointLaw.{u_1} : {X : Type u_1} →
  [inst : MeasurableSpace X] →
    MeasureTheory.ProbabilityMeasure X → ℕ → MeasureTheory.Measure (Luce.FinitePointMeasure X) :=
fun {X} [MeasurableSpace X] p m =>
  MeasureTheory.Measure.map Luce.FinitePointMeasure.ofFin (MeasureTheory.Measure.pi fun x => ↑p)
def Luce.poissonMixture.{u_1} : {E : Type u_1} →
  [inst : MeasurableSpace E] → NNReal → (ℕ → MeasureTheory.Measure E) → MeasureTheory.Measure E :=
fun {E} [MeasurableSpace E] r Q => (ProbabilityTheory.poissonMeasure r).bind Q
structure Luce.FiniteAdaptedBernoulli.{u_1} {Ω : Type u_1} {mΩ : MeasurableSpace Ω} (P : MeasureTheory.Measure Ω)
  (n : ℕ) : Type u_1
number of parameters: 4
fields:
  Luce.FiniteAdaptedBernoulli.filtration : MeasureTheory.Filtration ℕ mΩ
  Luce.FiniteAdaptedBernoulli.observation : Fin n → Ω → Bool
  Luce.FiniteAdaptedBernoulli.adapted : ∀ (k : Fin n), Measurable (self.observation k)
constructor:
  Luce.FiniteAdaptedBernoulli.mk.{u_1} {Ω : Type u_1} {mΩ : MeasurableSpace Ω} {P : MeasureTheory.Measure Ω} {n : ℕ}
    (filtration : MeasureTheory.Filtration ℕ mΩ) (observation : Fin n → Ω → Bool)
    (adapted : ∀ (k : Fin n), Measurable (observation k)) : Luce.FiniteAdaptedBernoulli P n
def Luce.raceInteriorBernoulli : {n : ℕ} →
  (w : Luce.Weights n) → ℝ → Luce.FiniteAdaptedBernoulli (Luce.exponentialRace w) n :=
fun {n} w α =>
  { filtration := Luce.raceDrawFiltration n,
    observation := fun k clocks => decide ((↑↑k + 1) / ↑n ≤ α ∧ (Luce.raceDraw clocks) k = k), adapted := ⋯ }
def Luce.FiniteAdaptedBernoulli.probability.{u_1} : {Ω : Type u_1} →
  {mΩ : MeasurableSpace Ω} →
    {P : MeasureTheory.Measure Ω} → {n : ℕ} → Luce.FiniteAdaptedBernoulli P n → Fin n → Ω → ℝ :=
fun {Ω} {mΩ} {P} {n} B k ω => max 0 (min 1 (P[B.observationReal k | ↑B.filtration ↑k] ω))
def Luce.BernoulliProcess.rowMaximum.{u_1} : {Ω : Type u_1} →
  {mΩ : MeasurableSpace Ω} → {μ : MeasureTheory.Measure Ω} → Luce.BernoulliProcess μ → ℕ → Ω → ℝ :=
fun {Ω} {mΩ} {μ} Y x x_1 => Nat.brecOn (motive := fun x => Ω → ℝ) x (Luce.BernoulliProcess.rowMaximum._f Y) x_1
