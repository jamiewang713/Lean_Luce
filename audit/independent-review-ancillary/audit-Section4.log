  MeasureTheory.Integrable (Luce.profileDiagonal f) (MeasureTheory.volume.restrict (Set.Ioo 0 1)) ∧
    (∀ (F : BoundedContinuousFunction (Luce.FinitePointMeasure ↑(Set.Icc 0 1)) ℝ),
        Filter.Tendsto (fun n => ∫ (e : Fin n → ℝ), F (Luce.fixedPoints (Luce.raceDraw e)) ∂Luce.exponentialRace (w n))
          Filter.atTop
          (nhds
            (∫ (ξ : Luce.FinitePointMeasure ↑(Set.Icc 0 1)),
              F ξ ∂Luce.finitePoissonLaw (Luce.fullIntensity w f hnorm hf hend)))) ∧
      Filter.Tendsto
        (fun n =>
          Luce.probabilityTotalVariation (Luce.raceFixedPointCountLaw (w n))
            (Luce.poissonProbabilityMeasure (∫ (x : ℝ) in Set.Ioo 0 1, Luce.profileDiagonal f x).toNNReal))
        Filter.atTop (nhds 0)
Luce.section4_main_poisson_general : ∀ (Ω : ℕ → Type u_1) [mΩ : (n : ℕ) → MeasurableSpace (Ω n)]
  (P : (n : ℕ) → MeasureTheory.Measure (Ω n)) [inst : ∀ (n : ℕ), MeasureTheory.IsProbabilityMeasure (P n)]
  (w : Luce.WeightArray) (f : ℝ → ℝ) (hnorm : Luce.NormalizedWeights w) (hf : Luce.ProfileLimit w f)
  (hend : Luce.EndpointAssumption w) (π : (n : ℕ) → Ω n → Equiv.Perm (Fin n)) (hπ : ∀ (n : ℕ), Measurable (π n)),
  (∀ (n : ℕ) (σ : Equiv.Perm (Fin n)), (P n).real {ω | π n ω = σ} = (w n).mass σ) →
    MeasureTheory.Integrable (Luce.profileDiagonal f) (MeasureTheory.volume.restrict (Set.Ioo 0 1)) ∧
      (∀ (F : BoundedContinuousFunction (Luce.FinitePointMeasure ↑(Set.Icc 0 1)) ℝ),
          Filter.Tendsto (fun n => ∫ (ω : Ω n), F (Luce.fixedPoints (π n ω)) ∂P n) Filter.atTop
            (nhds
              (∫ (ξ : Luce.FinitePointMeasure ↑(Set.Icc 0 1)),
                F ξ ∂Luce.finitePoissonLaw (Luce.fullIntensity w f hnorm hf hend)))) ∧
        Filter.Tendsto
          (fun n =>
            Luce.probabilityTotalVariation (Luce.fixedPointCountLaw (P n) (π n) ⋯)
              (Luce.poissonProbabilityMeasure (∫ (x : ℝ) in Set.Ioo 0 1, Luce.profileDiagonal f x).toNNReal))
          Filter.atTop (nhds 0)
Luce.section4_tail_expectation_bound_of_endpoint_witness : ∀ (Ω : ℕ → Type u_1) [inst : (n : ℕ) → MeasurableSpace (Ω n)]
  (P : (n : ℕ) → MeasureTheory.Measure (Ω n)) [∀ (n : ℕ), MeasureTheory.IsProbabilityMeasure (P n)]
  (w : Luce.WeightArray),
  Luce.NormalizedWeights w →
    ∀ (γ ε₀ : ℝ) (n₀ : ℕ),
      0 < γ →
        0 < ε₀ →
          (∀ (n : ℕ), n₀ ≤ n → ∀ (k : Fin n), (1 - ε₀) * ↑n ≤ ↑↑k + 1 → γ ≤ (w n).rate k) →
            ∀ (E : (n : ℕ) → Fin n → Ω n → ℝ),
              (∀ (n : ℕ) (i : Fin n),
                  ProbabilityTheory.HasLaw (E n i) (ProbabilityTheory.expMeasure ((w n).rate i)) (P n)) →
                (∀ (n : ℕ), ProbabilityTheory.iIndepFun (E n) (P n)) →
                  ∃ δ,
                    0 < δ ∧
                      ∀ (ε : ℝ),
                        0 < ε →
                          ε < δ →
                            Filter.limsup
                                (fun n => ∫ (ω : Ω n), ↑(Luce.tailFixedPointCount (fun i => E n i ω) (1 - ε)) ∂P n)
                                Filter.atTop ≤
                              2 ^ (1 + γ / 2) * ε ^ (γ / 4)
