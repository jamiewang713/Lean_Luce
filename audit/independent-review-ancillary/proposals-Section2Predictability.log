def Luce.Section2Proposal.drawHistory.{u} : {Ω : Type u} → {n : ℕ} → (Ω → Equiv.Perm (Fin n)) → ℕ → MeasurableSpace Ω :=
fun {Ω} {n} π m => ⨆ j, ⨆ (_ : ↑j < m), MeasurableSpace.comap (fun ω => (π ω) j) ⊤
def Luce.Section2Proposal.PredictabilityStatement.{u} : Prop :=
∀ {Ω : Type u} {n : ℕ} (w : Weights n) (π : Ω → Equiv.Perm (Fin n)) (k : Fin n),
  (Measurable fun ω => if k ≤ (Equiv.symm (π ω)) k then 1 else 0) ∧ Measurable fun ω => w.total (remaining (π ω) k)
'Luce.Section2Proposal.drawHistory' depends on axioms: [propext, Classical.choice, Quot.sound]
'Luce.Section2Proposal.PredictabilityStatement' depends on axioms: [propext, Classical.choice, Quot.sound]
