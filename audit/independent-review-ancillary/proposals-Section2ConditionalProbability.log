def Luce.Section2ConditionalProposal.PredictableProbabilityStatement.{u} : Prop :=
∀ {Ω : Type u} [mΩ : MeasurableSpace Ω] {n : ℕ} (P : Measure Ω) [hP : IsProbabilityMeasure P] (w : Weights n)
  (π : Ω → Equiv.Perm (Fin n)),
  Measurable π →
    (∀ (σ : Equiv.Perm (Fin n)), P.real {ω | π ω = σ} = w.mass σ) →
      ∀ (k : Fin n),
        P[fun ω => if (Equiv.symm (π ω)) k = k then 1 else 0 | drawHistory π ↑k] =ᵐ[P] fun ω =>
          (if k ≤ (Equiv.symm (π ω)) k then w.rate k else 0) / w.total (remaining (π ω) k)
