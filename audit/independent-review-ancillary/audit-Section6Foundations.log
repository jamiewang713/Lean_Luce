def SampledProfileContract.section6.{u} : Prop :=
And (SampledProfileContract.powerLaw.{u} Luce.Section6.SamplingGrid.midpoint)
  (And (SampledProfileContract.spatial.{u} Luce.Section6.SamplingGrid.midpoint)
    (And (SampledProfileContract.critical.{u} Luce.Section6.SamplingGrid.midpoint)
      (And (SampledProfileContract.powerLaw.{u} Luce.Section6.SamplingGrid.interior)
        (And (SampledProfileContract.spatial.{u} Luce.Section6.SamplingGrid.interior)
          (SampledProfileContract.critical.{u} Luce.Section6.SamplingGrid.interior)))))
