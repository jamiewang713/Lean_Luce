def Luce.Section4Proposal.TailTightnessStatement.{u} : Prop :=
∀ (Ω : ℕ → Type u) [mΩ : (n : ℕ) → MeasurableSpace (Ω n)] (P : (n : ℕ) → Measure (Ω n))
  [hP : ∀ (n : ℕ), IsProbabilityMeasure (P n)] (w : WeightArray),
  NormalizedWeights w →
    EndpointAssumption w →
      ∀ (E : (n : ℕ) → Fin n → Ω n → ℝ),
        (∀ (n : ℕ) (i : Fin n), HasLaw (E n i) (expMeasure ((w n).rate i)) (P n)) →
          (∀ (n : ℕ), iIndepFun (E n) (P n)) →
            Tendsto (fun α => limsup (fun n => (P n).real {ω | 0 < tailFixedPointCount (fun i => E n i ω) α}) atTop)
              (𝓝[<] 1) (𝓝 0)
'Luce.Section4Proposal.tailFixedPointCount' depends on axioms: [propext, Classical.choice, Quot.sound]
