            (congrArg
              (fun _a => w.choice (Luce.remaining σ k) k * Luce.prefixMass w σ ↑k = Luce.predictableChance w σ k * _a)
              (Luce.sum_mass_prefix w σ (↑k) (Nat.le_of_lt k.isLt))))
          (Eq.refl (w.choice (Luce.remaining σ k) k * Luce.prefixMass w σ ↑k)))))
def Luce.prefixVector : {n : ℕ} → Equiv.Perm (Fin n) → (m : ℕ) → { j // ↑j < m } → Fin n :=
fun {n} σ m j => σ ↑j
theorem Luce.drawHistory_eq_comap_prefixVector.{u_1} : ∀ {Ω : Type u_1} {n : ℕ} (π : Ω → Equiv.Perm (Fin n)) (m : ℕ),
  Luce.drawHistory π m = MeasurableSpace.comap (fun ω => Luce.prefixVector (π ω) m) ⊤ :=
fun {Ω} {n} π m =>
  let this := ⊤;
  have htop := top_unique fun x x_1 => MeasurableSet.of_discrete;
  Eq.mpr
    (id
      (congrArg (fun _a => Luce.drawHistory π m = MeasurableSpace.comap (fun ω => Luce.prefixVector (π ω) m) _a)
        (Eq.symm htop)))
    (Eq.mpr
      (id
        (congrArg (Eq (⨆ j, ⨆ (_ : ↑j < m), MeasurableSpace.comap (fun ω => (π ω) j) ⊤))
          (Eq.trans (MeasurableSpace.comap_process_pi fun a b => Luce.prefixVector (π b) m a)
            (Eq.trans iSup_subtype
              (congrArg iSup
                (funext fun i =>
                  iSup_congr_Prop (Iff.of_eq (Eq.refl (↑i < m))) fun x =>
                    Eq.refl (MeasurableSpace.comap (fun b => (π b) i) inferInstance)))))))
      (Eq.refl (⨆ j, ⨆ (_ : ↑j < m), MeasurableSpace.comap (fun ω => (π ω) j) ⊤)))
theorem Luce.prefixVector_eq_iff : ∀ {n : ℕ} (σ τ : Equiv.Perm (Fin n)) (m : ℕ),
  Luce.prefixVector σ m = Luce.prefixVector τ m ↔ ∀ (j : Fin n), ↑j < m → σ j = τ j :=
fun {n} σ τ m => { mp := fun h j hj => congrFun h ⟨j, hj⟩, mpr := fun h => funext fun j => h (↑j) j.property }
theorem Luce.remaining_eq_of_prefix_agreement : ∀ {n : ℕ} (σ τ : Equiv.Perm (Fin n)) (k : Fin n),
  (∀ j < k, σ j = τ j) → Luce.remaining σ k = Luce.remaining τ k :=
fun {n} σ τ k hprefix =>
  Finset.ext fun i =>
    Eq.mpr
      (id
        (congr
          (congrArg Iff
            (Eq.trans
              (Eq.trans
                (congrFun'
                  (congrArg Membership.mem
                    (Finset.filter_congr fun x a => Iff.of_eq (Luce.remaining_eq_of_prefix_agreement._simp_1_3 σ k x)))
                  i)
                Luce.remaining_eq_of_prefix_agreement._simp_1_1)
              (Eq.trans
                (congrFun' (congrArg And (Luce.remaining_eq_of_prefix_agreement._simp_1_2 i)) (∀ j < k, σ j ≠ i))
                (true_and (∀ j < k, σ j ≠ i)))))
          (Eq.trans
            (Eq.trans
              (congrFun'
                (congrArg Membership.mem
                  (Finset.filter_congr fun x a => Iff.of_eq (Luce.remaining_eq_of_prefix_agreement._simp_1_3 τ k x)))
                i)
              Luce.remaining_eq_of_prefix_agreement._simp_1_1)
            (Eq.trans (congrFun' (congrArg And (Luce.remaining_eq_of_prefix_agreement._simp_1_2 i)) (∀ j < k, τ j ≠ i))
              (true_and (∀ j < k, τ j ≠ i))))))
      { mp := fun h j hj => Eq.mpr (id (congrFun' (congrArg Ne (Eq.symm (hprefix j hj))) i)) (h j hj),
        mpr := fun h j hj => Eq.mpr (id (congrFun' (congrArg Ne (hprefix j hj)) i)) (h j hj) }
theorem Luce.predictableChance_eq_of_prefix_agreement : ∀ {n : ℕ} (w : Luce.Weights n) (σ τ : Equiv.Perm (Fin n))
  (k : Fin n), (∀ j < k, σ j = τ j) → Luce.predictableChance w σ k = Luce.predictableChance w τ k :=
fun {n} w σ τ k hprefix =>
  id
    (Eq.mpr
      (id
        (congrArg (fun _a => w.choice _a k = w.choice (Luce.remaining τ k) k)
          (Luce.remaining_eq_of_prefix_agreement σ τ k hprefix)))
      (Eq.refl (w.choice (Luce.remaining τ k) k)))
theorem Luce.integrable_finite_state.{u_1, u_2} : ∀ {Ω : Type u_1} {S : Type u_2} {mΩ : MeasurableSpace Ω}
  {P : Measure Ω} [IsProbabilityMeasure P] [Fintype S] (Z : Ω → S),
  Measurable Z → ∀ (f : S → ℝ), Integrable (fun ω => f (Z ω)) P :=
fun {Ω} {S} {mΩ} {P} [IsProbabilityMeasure P] [Fintype S] Z hZ f =>
  have hset := fun s => id (hZ trivial);
  have hrepr :=
    funext fun ω =>
      of_eq_true
        (Eq.trans
          (congrArg (Eq (f (Z ω)))
            (Eq.trans
              (Eq.trans
                (congrArg Finset.univ.sum
                  (funext fun s =>
                    ite_congr
                      (congrFun'
                        (congrArg Membership.mem
                          (congrArg Set.ofPred (funext fun ω => Luce.integrable_finite_state._simp_1_1)))
                        ω)
                      (fun a => Eq.refl (f s)) fun a => Eq.refl 0))
                (Finset.sum_ite_eq' Finset.univ (Z ω) f))
              (ite_cond_eq_true (f (Z ω)) 0 (Finset.mem_univ._simp_1 (Z ω)))))
          (eq_self (f (Z ω))));
  Eq.mpr (id (congrArg (fun _a => Integrable _a P) hrepr))
    (integrable_finsetSum Finset.univ fun s x => Integrable.indicator (integrable_const (f s)) (hset s))
theorem Luce.integral_finite_state.{u_1, u_2} : ∀ {Ω : Type u_1} {S : Type u_2} {mΩ : MeasurableSpace Ω} {P : Measure Ω}
  [IsProbabilityMeasure P] [inst : Fintype S] (Z : Ω → S),
  Measurable Z → ∀ (f : S → ℝ), ∫ (ω : Ω), f (Z ω) ∂P = ∑ s, P.real {ω | Z ω = s} * f s :=
fun {Ω} {S} {mΩ} {P} [IsProbabilityMeasure P] [Fintype S] Z hZ f =>
  have hset := fun s => id (hZ trivial);
  have hrepr :=
    funext fun ω =>
      of_eq_true
        (Eq.trans
          (congrArg (Eq (f (Z ω)))
            (Eq.trans
              (Eq.trans
                (congrArg Finset.univ.sum
                  (funext fun s =>
                    ite_congr
                      (congrFun'
                        (congrArg Membership.mem
                          (congrArg Set.ofPred (funext fun ω => Luce.integral_finite_state._simp_1_1)))
                        ω)
                      (fun a => Eq.refl (f s)) fun a => Eq.refl 0))
                (Finset.sum_ite_eq' Finset.univ (Z ω) f))
              (ite_cond_eq_true (f (Z ω)) 0 (Finset.mem_univ._simp_1 (Z ω)))))
          (eq_self (f (Z ω))));
  Eq.mpr (id (congrArg (fun _a => integral P _a = ∑ s, P.real {ω | Z ω = s} * f s) hrepr))
    (Eq.mpr
      (id
        (congrArg (fun _a => _a = ∑ s, P.real {ω | Z ω = s} * f s)
          (integral_finsetSum Finset.univ fun s x => Integrable.indicator (integrable_const (f s)) (hset s))))
      (Finset.sum_congr rfl fun s a =>
        Eq.mpr (id (congrArg (fun _a => _a = P.real {ω | Z ω = s} * f s) (integral_indicator_const (f s) (hset s))))
          (Eq.mpr (id (congrArg (fun _a => _a = P.real {ω | Z ω = s} * f s) (smul_eq_mul (P.real {ω | Z ω = s}) (f s))))
            (Eq.refl (P.real {ω | Z ω = s} * f s)))))
theorem Luce.condExp_finite_history.{u_1, u_2, u_3} : ∀ {Ω : Type u_1} {S : Type u_2} {T : Type u_3}
  {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsProbabilityMeasure P] [inst : Fintype S] [Fintype T]
  [inst_2 : DecidableEq T] (Z : Ω → S),
  Measurable Z →
    ∀ (H : S → T) (f : S → ℝ) (g : T → ℝ),
      (∀ (t : T), ∑ s with H s = t, P.real {ω | Z ω = s} * f s = g t * ∑ s with H s = t, P.real {ω | Z ω = s}) →
        P[fun ω => f (Z ω) | MeasurableSpace.comap (fun ω => H (Z ω)) ⊤] =ᵐ[P] fun ω => g (H (Z ω)) :=
fun {Ω} {S} {T} {mΩ} {P} [IsProbabilityMeasure P] [Fintype S] [Fintype T] [DecidableEq T] Z hZ H f g hfiber =>
  let this := ⊤;
  let this_1 := ⊤;
  have hH := fun x x_1 => trivial;
  have hY := Measurable.comp hH hZ;
  have hg := fun x x_1 => trivial;
  have hgm := Measurable.comp hg (comap_measurable fun ω => H (Z ω));
  have hgi := Luce.integrable_finite_state Z hZ fun s => g (H s);
  Filter.EventuallyEq.symm
    (ae_eq_condExp_of_forall_setIntegral_eq (Measurable.comap_le hY) (Luce.integrable_finite_state Z hZ f)
      (fun x x_1 x_2 => Integrable.integrableOn hgi)
      (fun a ha a_1 =>
        Exists.casesOn (MeasurableSpace.measurableSet_comap.mp ha) fun b h =>
          And.casesOn h fun hb right =>
            Eq.ndrec (motive := fun a =>
              MeasurableSet a → P a < ⊤ → ∫ (x : Ω) in a, g (H (Z x)) ∂P = ∫ (x : Ω) in a, f (Z x) ∂P)
              (fun ha a =>
                have hset := hY hb;
                have hleft :=
                  Eq.mpr
                    (id
                      (congrArg (fun _a => _a = ∑ s, P.real {ω | Z ω = s} * if H s ∈ b then g (H s) else 0)
                        (Eq.symm (integral_indicator hset))))
                    (Eq.mpr
                      (id
                        (congrFun'
                          (congrArg Eq
                            (congrArg (integral P)
                              (funext fun x =>
                                ite_congr Luce.condExp_finite_history._simp_1_1 (fun a => Eq.refl (g (H (Z x))))
                                  fun a => Eq.refl 0)))
                          (∑ s, P.real {ω | Z ω = s} * if H s ∈ b then g (H s) else 0)))
                      (Luce.integral_finite_state Z hZ fun s => if H s ∈ b then g (H s) else 0));
                have hright :=
                  Eq.mpr
                    (id
                      (congrArg (fun _a => _a = ∑ s, P.real {ω | Z ω = s} * if H s ∈ b then f s else 0)
                        (Eq.symm (integral_indicator hset))))
                    (Eq.mpr
                      (id
                        (congrFun'
                          (congrArg Eq
                            (congrArg (integral P)
                              (funext fun x =>
                                ite_congr Luce.condExp_finite_history._simp_1_1 (fun a => Eq.refl (f (Z x))) fun a =>
                                  Eq.refl 0)))
                          (∑ s, P.real {ω | Z ω = s} * if H s ∈ b then f s else 0)))
                      (Luce.integral_finite_state Z hZ fun s => if H s ∈ b then f s else 0));
                Eq.mpr (id (congrArg (fun _a => _a = ∫ (x : Ω) in (fun ω => H (Z ω)) ⁻¹' b, f (Z x) ∂P) hleft))
                  (Eq.mpr
                    (id (congrArg (fun _a => (∑ s, P.real {ω | Z ω = s} * if H s ∈ b then g (H s) else 0) = _a) hright))
                    (Eq.mpr
                      (id
                        (congrArg (fun _a => _a = ∑ s, P.real {ω | Z ω = s} * if H s ∈ b then f s else 0)
                          (Eq.symm
                            (Finset.sum_fiberwise Finset.univ H fun s =>
                              P.real {ω | Z ω = s} * if H s ∈ b then g (H s) else 0))))
                      (Eq.mpr
                        (id
                          (congrArg
                            (fun _a =>
                              (∑ j, ∑ i with H i = j, P.real {ω | Z ω = i} * if H i ∈ b then g (H i) else 0) = _a)
                            (Eq.symm
                              (Finset.sum_fiberwise Finset.univ H fun s =>
                                P.real {ω | Z ω = s} * if H s ∈ b then f s else 0))))
                        (Finset.sum_congr rfl fun t a =>
                          if ht : t ∈ b then
                            Trans.trans
                              (Trans.trans
                                (Trans.trans
                                  (Finset.sum_congr rfl fun s hs =>
                                    of_eq_true
                                      (Eq.trans
                                        (congrFun'
                                          (congrArg Eq
                                            (congrArg (HMul.hMul (P.real {ω | Z ω = s}))
                                              (Eq.trans
                                                (ite_congr (congrArg (Membership.mem b) (Finset.mem_filter.mp hs).right)
                                                  (fun a => congrArg g (Finset.mem_filter.mp hs).right) fun a =>
                                                  Eq.refl 0)
                                                ((fun x_0 x_1 x_2 x_3 =>
                                                    (fun x_0 x_1 x_2 x_3 => if_pos ht) x_0 x_1 x_2 x_3)
                                                  (Classical.propDecidable (t ∈ b)) ℝ (g t) 0))))
                                          (P.real {ω | Z ω = s} * g t))
                                        (eq_self (P.real {ω | Z ω = s} * g t))))
                                  (Eq.mpr
                                    (id
                                      (congrArg (fun _a => _a = g t * ∑ s with H s = t, P.real {ω | Z ω = s})
                                        (Eq.symm (Finset.sum_mul {s | H s = t} (fun s => P.real {ω | Z ω = s}) (g t)))))
                                    (Eq.mpr
                                      (id
                                        (congrArg (fun _a => _a = g t * ∑ s with H s = t, P.real {ω | Z ω = s})
                                          (mul_comm (∑ i with H i = t, P.real {ω | Z ω = i}) (g t))))
                                      (Eq.refl (g t * ∑ i with H i = t, P.real {ω | Z ω = i})))))
                                (Eq.symm (hfiber t)))
                              (Finset.sum_congr rfl fun s hs =>
                                of_eq_true
                                  (Eq.trans
                                    (congrArg (Eq (P.real {ω | Z ω = s} * f s))
                                      (congrArg (HMul.hMul (P.real {ω | Z ω = s}))
                                        (Eq.trans
                                          (ite_congr (congrArg (Membership.mem b) (Finset.mem_filter.mp hs).right)
                                            (fun a => Eq.refl (f s)) fun a => Eq.refl 0)
                                          ((fun x_0 x_1 x_2 x_3 => (fun x_0 x_1 x_2 x_3 => if_pos ht) x_0 x_1 x_2 x_3)
                                            (Classical.propDecidable (t ∈ b)) ℝ (f s) 0))))
                                    (eq_self (P.real {ω | Z ω = s} * f s))))
                          else
                            have hzero := fun v =>
                              Finset.sum_eq_zero fun s hs =>
                                of_eq_true
                                  (Eq.trans
                                    (congrFun'
                                      (congrArg Eq
                                        (Eq.trans
                                          (congrArg (HMul.hMul (P.real {ω | Z ω = s}))
                                            (Eq.trans
                                              (ite_congr (congrArg (Membership.mem b) (Finset.mem_filter.mp hs).right)
                                                (fun a => Eq.refl (v s)) fun a => Eq.refl 0)
                                              ((fun x_0 x_1 x_2 x_3 =>
                                                  (fun x_0 x_1 x_2 x_3 => if_neg ht) x_0 x_1 x_2 x_3)
                                                (Classical.propDecidable (t ∈ b)) ℝ (v s) 0)))
                                          (mul_zero (P.real {ω | Z ω = s}))))
                                      0)
                                    (eq_self 0));
                            Eq.mpr
                              (id
                                (congrArg
                                  (fun _a => _a = ∑ i with H i = t, P.real {ω | Z ω = i} * if H i ∈ b then f i else 0)
                                  (hzero fun s => g (H s))))
                              (Eq.mpr (id (congrArg (fun _a => 0 = _a) (hzero f))) (Eq.refl 0)))))))
              right ha a_1)
      (StronglyMeasurable.aestronglyMeasurable (Measurable.stronglyMeasurable hgm)))
theorem Luce.condExp_finite_history_of_representatives.{u_1, u_2, u_3} : ∀ {Ω : Type u_1} {S : Type u_2} {T : Type u_3}
  {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsProbabilityMeasure P] [inst : Fintype S] [Fintype T]
  [inst_2 : DecidableEq T] (Z : Ω → S),
  Measurable Z →
    ∀ (H : S → T) (f r : S → ℝ),
      (∀ (s₁ s₂ : S), H s₁ = H s₂ → r s₁ = r s₂) →
        (∀ (s : S), ∑ u with H u = H s, P.real {ω | Z ω = u} * f u = r s * ∑ u with H u = H s, P.real {ω | Z ω = u}) →
          P[fun ω => f (Z ω) | MeasurableSpace.comap (fun ω => H (Z ω)) ⊤] =ᵐ[P] fun ω => r (Z ω) :=
fun {Ω} {S} {T} {mΩ} {P} [IsProbabilityMeasure P] [Fintype S] [Fintype T] [DecidableEq T] Z hZ H f r hconst hfiber =>
  let g := fun t => if h : ∃ s, H s = t then r h.choose else 0;
  have hg := fun s =>
    id
      (if h : ∃ s_1, H s_1 = H s then
        Eq.mpr (id (congrFun' (congrArg Eq (dif_pos h)) (r s))) (hconst h.choose s (Exists.choose_spec h))
      else Eq.mpr (id (congrFun' (congrArg Eq (dif_neg h)) (r s))) (False.elim (h (Exists.intro s rfl))));
  have hfiber' := fun t =>
    if h : ∃ s, H s = t then
      Exists.casesOn h fun s h =>
        h ▸
          Eq.mpr
            (id
              (congrArg
                (fun _a =>
                  ∑ s with H s = H s, P.real {ω | Z ω = s} * f s = _a * ∑ s with H s = H s, P.real {ω | Z ω = s})
                (hg s)))
            (hfiber s)
    else
      have he := Finset.filter_eq_empty_iff.mpr fun ⦃s⦄ a hs => h (Exists.intro s hs);
      of_eq_true
        (Eq.trans
          (congr (congrArg Eq (Finset.sum_congr he fun x a => Eq.refl (P.real {ω | Z ω = x} * f x)))
            (Eq.trans (congrArg (HMul.hMul (g t)) (Finset.sum_congr he fun x a => Eq.refl (P.real {ω | Z ω = x})))
              (mul_zero (g t))))
          (eq_self 0));
  Filter.EventuallyEq.trans (Luce.condExp_finite_history Z hZ H f g hfiber') (ae_of_all P fun ω => hg (Z ω))
theorem Luce.drawHistory_le.{u} : ∀ {Ω : Type u} [mΩ : MeasurableSpace Ω] {n : ℕ} (π : Ω → Equiv.Perm (Fin n)),
  Measurable π → ∀ (m : ℕ), Luce.drawHistory π m ≤ mΩ :=
fun {Ω} [MeasurableSpace Ω] {n} π hπ m =>
  iSup_le fun j =>
    iSup_le fun i =>
      have hj := fun x x_1 => trivial;
      Measurable.comap_le (Measurable.comp hj hπ)
theorem Luce.measurable_predictableChance_history.{u} : ∀ {Ω : Type u} {n : ℕ} (w : Luce.Weights n)
  (π : Ω → Equiv.Perm (Fin n)) (k : Fin n), Measurable fun ω => Luce.predictableChance w (π ω) k :=
fun {Ω} {n} w π k =>
  Eq.mpr (id (congrArg Measurable (funext fun ω => Luce.predictableChance_formula w (π ω) k)))
    (Measurable.div (Measurable.ite (Luce.measurableSet_label_available π k k) measurable_const measurable_const)
      (Luce.measurable_remaining_weight w π k))
theorem Luce.integrable_predictableChance.{u} : ∀ {Ω : Type u} [mΩ : MeasurableSpace Ω] (P : Measure Ω)
  [IsProbabilityMeasure P] {n : ℕ} (w : Luce.Weights n) (π : Ω → Equiv.Perm (Fin n)),
  Measurable π → ∀ (k : Fin n), Integrable (fun ω => Luce.predictableChance w (π ω) k) P :=
fun {Ω} [MeasurableSpace Ω] P [IsProbabilityMeasure P] {n} w π hπ k =>
  ⟨Measurable.aestronglyMeasurable
      (Measurable.mono (Luce.measurable_predictableChance_history w π k) (Luce.drawHistory_le π hπ ↑k) le_rfl),
    HasFiniteIntegral.of_mem_Icc 0 1
      (ae_of_all P fun ω =>
        ⟨Luce.Weights.choice_nonneg w (Luce.remaining (π ω) k) k,
          Luce.Weights.choice_le_one w (Luce.remaining (π ω) k) k⟩)⟩
theorem Luce.integrable_fixed_point_indicator.{u} : ∀ {Ω : Type u} [mΩ : MeasurableSpace Ω] (P : Measure Ω)
  [IsProbabilityMeasure P] {n : ℕ} (π : Ω → Equiv.Perm (Fin n)),
  Measurable π → ∀ (k : Fin n), Integrable (fun ω => if (Equiv.symm (π ω)) k = k then 1 else 0) P :=
fun {Ω} [MeasurableSpace Ω] P [IsProbabilityMeasure P] {n} π hπ k =>
  have hs :=
    hπ
      (have this := trivial;
      this);
  ⟨Measurable.aestronglyMeasurable (Measurable.ite hs measurable_const measurable_const),
    HasFiniteIntegral.of_mem_Icc 0 1
      (ae_of_all P fun ω =>
        if h : (Equiv.symm (π ω)) k = k then
          Eq.mpr (id (congrArg (Membership.mem (Set.Icc 0 1)) (if_pos h)))
            (of_eq_true
              (Eq.trans Set.mem_Icc._simp_1
                (Eq.trans (congr (congrArg And zero_le_one._simp_1) (Std.le_refl._simp_1 1)) (and_self True))))
        else
          Eq.mpr (id (congrArg (Membership.mem (Set.Icc 0 1)) (if_neg h)))
            (of_eq_true
              (Eq.trans Set.mem_Icc._simp_1
                (Eq.trans (congr (congrArg And (Std.le_refl._simp_1 0)) zero_le_one._simp_1) (and_self True)))))⟩
theorem Luce.predictable_fixed_point_probability.{u} : ∀ {Ω : Type u} [mΩ : MeasurableSpace Ω] {n : ℕ} (P : Measure Ω)
  [IsProbabilityMeasure P] (w : Luce.Weights n) (π : Ω → Equiv.Perm (Fin n)),
  Measurable π →
    (∀ (σ : Equiv.Perm (Fin n)), P.real {ω | π ω = σ} = w.mass σ) →
      ∀ (k : Fin n),
        P[fun ω => if (Equiv.symm (π ω)) k = k then 1 else 0 | Luce.drawHistory π ↑k] =ᵐ[P] fun ω =>
          (if k ≤ (Equiv.symm (π ω)) k then w.rate k else 0) / w.total (Luce.remaining (π ω) k) :=
fun {Ω} [MeasurableSpace Ω] {n} P [IsProbabilityMeasure P] w π hπ hMass k =>
  have hconstant := fun σ τ h =>
    Luce.predictableChance_eq_of_prefix_agreement w σ τ k ((Luce.prefixVector_eq_iff σ τ ↑k).mp h);
  have hfiber := fun σ =>
    Eq.mpr
      (id
        (congr
          (congrArg Eq
            (Finset.sum_congr (Eq.refl {τ | Luce.prefixVector τ ↑k = Luce.prefixVector σ ↑k}) fun x a =>
              congrFun' (congrArg HMul.hMul ((fun σ => hMass σ) x)) (if (Equiv.symm x) k = k then 1 else 0)))
          (congrArg (HMul.hMul (Luce.predictableChance w σ k))
            (Finset.sum_congr (Eq.refl {τ | Luce.prefixVector τ ↑k = Luce.prefixVector σ ↑k}) fun x a =>
              (fun σ => hMass σ) x))))
      (Luce.fixed_point_mass_fiber_identity w σ k);
  have h :=
    Luce.condExp_finite_history_of_representatives π hπ (fun σ => Luce.prefixVector σ ↑k)
