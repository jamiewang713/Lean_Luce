        (Eq.mpr (id (congrArg (fun _a => 0 = _a) (zero_mul (Luce.prefixMass w σ ↑k)))) (Eq.refl 0)))
theorem Luce.fixed_point_mass_fiber_identity : ∀ {n : ℕ} (w : Luce.Weights n) (σ : Equiv.Perm (Fin n)) (k : Fin n),
