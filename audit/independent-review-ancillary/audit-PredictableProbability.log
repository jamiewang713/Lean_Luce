                        (Eq.refl (w.rate i / w.total (Luce.remaining σ k) * Luce.prefixMass w σ ↑k)))))))))
  else
    have hnone := fun τ a =>
      And.casesOn a fun hστ hτk =>
        have hrem := Luce.remaining_eq_of_prefix_agreement σ τ k hστ;
        have hi :=
          Eq.mpr (id (congrArg (fun _a => _a ∈ Luce.remaining τ k) (Eq.symm hτk)))
