      (congrArg (Eq (∑ i, if k ≤ (Equiv.symm σ) i then w.rate i else 0))
        (Finset.sum_congr (Eq.refl Finset.univ) fun x a =>
          ite_congr (congrArg (LE.le k) (Equiv.symm_apply_apply σ x)) (fun a => Eq.refl (w.rate (σ x))) fun a =>
            Eq.refl 0))
      (Eq.symm (Equiv.sum_comp σ fun i => if k ≤ (Equiv.symm σ) i then w.rate i else 0)))
theorem Luce.prefixMass_succ : ∀ {n : ℕ} (w : Luce.Weights n) (σ : Equiv.Perm (Fin n)) (k : Fin n),
  Luce.prefixMass w σ (↑k + 1) = Luce.prefixMass w σ ↑k * (w.rate (σ k) / w.total (Luce.remaining σ k)) :=
fun {n} w σ k =>
  have hset :=
    Finset.ext fun r =>
      Eq.mpr
        (id
          (congr
            (congrArg Iff
              (Eq.trans Luce.prefixMass_succ._simp_1_1
                (Eq.trans (congrFun' (congrArg And (Luce.prefixMass_succ._simp_1_2 r)) (↑r < ↑k + 1))
                  (true_and (↑r < ↑k + 1)))))
            (Eq.trans Luce.prefixMass_succ._simp_1_3
              (congr (congrArg Or Luce.prefixMass_succ._simp_1_4)
                (Eq.trans Luce.prefixMass_succ._simp_1_1
                  (Eq.trans (congrFun' (congrArg And (Luce.prefixMass_succ._simp_1_2 r)) (↑r < ↑k))
                    (true_and (↑r < ↑k))))))))
        (Decidable.byContradiction fun a => Luce.prefixMass_succ._proof_1_5 k r a);
  id
    (Eq.mpr
      (id
        (congrArg
          (fun _a =>
            ∏ r ∈ _a, w.rate (σ r) / ∑ j with r ≤ j, w.rate (σ j) =
              (∏ r with ↑r < ↑k, w.rate (σ r) / ∑ j with r ≤ j, w.rate (σ j)) *
                (w.rate (σ k) / w.total (Luce.remaining σ k)))
          hset))
      (Eq.mpr
        (id
          (congrArg
            (fun _a =>
              _a =
                (∏ r with ↑r < ↑k, w.rate (σ r) / ∑ j with r ≤ j, w.rate (σ j)) *
                  (w.rate (σ k) / w.total (Luce.remaining σ k)))
            (Finset.prod_insert
              (of_eq_true
                (Eq.trans
                  (congrArg Not
                    (Eq.trans
                      (Eq.trans
                        (congrFun'
                          (congrArg Membership.mem (Finset.filter_congr fun x a => Iff.of_eq Fin.val_fin_lt._simp_1)) k)
                        Finset.mem_filter._simp_1)
                      (Eq.trans (congr (congrArg And (Finset.mem_univ._simp_1 k)) (lt_self_iff_false._simp_1 k))
                        (and_false True))))
                  not_false_eq_true)))))
        (Eq.mpr
          (id
            (congrArg
              (fun _a =>
                (w.rate (σ k) / ∑ j with k ≤ j, w.rate (σ j)) *
                    ∏ x with ↑x < ↑k, w.rate (σ x) / ∑ j with x ≤ j, w.rate (σ j) =
                  (∏ r with ↑r < ↑k, w.rate (σ r) / ∑ j with r ≤ j, w.rate (σ j)) * (w.rate (σ k) / _a))
