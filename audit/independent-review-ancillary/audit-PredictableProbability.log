theorem Luce.remaining_total_eq_tail_sum : ∀ {n : ℕ} (w : Luce.Weights n) (σ : Equiv.Perm (Fin n)) (k : Fin n),
  w.total (Luce.remaining σ k) = ∑ j with k ≤ j, w.rate (σ j) :=
fun {n} w σ k =>
  Eq.mpr
    (id
      (congr (congrArg Eq (Finset.sum_filter (fun a => k ≤ (Equiv.symm σ) a) w.rate))
        (Finset.sum_filter (LE.le k) fun a => w.rate (σ a))))
