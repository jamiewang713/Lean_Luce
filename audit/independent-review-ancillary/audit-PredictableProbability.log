theorem Luce.prefixMass_eq_of_prefix_agreement : ∀ {n : ℕ} (w : Luce.Weights n) (σ τ : Equiv.Perm (Fin n)) (m : ℕ),
  Luce.prefixAgrees σ τ m → Luce.prefixMass w σ m = Luce.prefixMass w τ m :=
fun {n} w σ τ m hprefix =>
  Finset.prod_congr rfl fun r hr =>
    have hrm := (Finset.mem_filter.mp hr).right;
    have hrem := Luce.remaining_eq_of_prefix_agreement σ τ r fun j hj => hprefix j (lt_trans hj hrm);
    Eq.mpr
      (id
        (congrArg (fun _a => w.rate (σ r) / _a = w.rate (τ r) / ∑ j with r ≤ j, w.rate (τ j))
          (Eq.symm (Luce.remaining_total_eq_tail_sum w σ r))))
      (Eq.mpr
        (id
          (congrArg (fun _a => w.rate (σ r) / w.total (Luce.remaining σ r) = w.rate (τ r) / _a)
            (Eq.symm (Luce.remaining_total_eq_tail_sum w τ r))))
        (Eq.mpr (id (congrArg (fun _a => w.rate (σ r) / w.total _a = w.rate (τ r) / w.total (Luce.remaining τ r)) hrem))
          (Eq.mpr
            (id
              (congrArg
                (fun _a => w.rate _a / w.total (Luce.remaining τ r) = w.rate (τ r) / w.total (Luce.remaining τ r))
                (hprefix r hrm)))
            (Eq.refl (w.rate (τ r) / w.total (Luce.remaining τ r))))))
theorem Luce.exists_prefixAgrees_next_eq : ∀ {n : ℕ} (σ : Equiv.Perm (Fin n)) (k i : Fin n),
  k ≤ (Equiv.symm σ) i → ∃ τ, Luce.prefixAgrees σ τ ↑k ∧ τ k = i :=
fun {n} σ k i havailable =>
  Exists.intro (Equiv.trans σ (Equiv.swap (σ k) i))
    ⟨fun j hj =>
      have hji := (Luce.inverse_ge_iff_no_earlier_draw σ k i).mp havailable j hj;
      have hjk := fun h => ne_of_lt hj (congrArg Fin.val (Equiv.injective σ h));
      of_eq_true (Eq.trans (congrArg (Eq (σ j)) (Equiv.swap_apply_of_ne_of_ne hjk hji)) (eq_self (σ j))),
      of_eq_true (Eq.trans (congrFun' (congrArg Eq (Equiv.swap_apply_left (σ k) i)) i) (eq_self i))⟩
theorem Luce.prefixAgrees_succ_iff : ∀ {n : ℕ} (σ τ : Equiv.Perm (Fin n)) (k : Fin n),
  Luce.prefixAgrees σ τ (↑k + 1) ↔ Luce.prefixAgrees σ τ ↑k ∧ σ k = τ k :=
fun {n} σ τ k =>
  { mp := fun h => ⟨fun j hj => h j (Nat.lt_succ_of_lt hj), h k (Nat.lt_succ_self ↑k)⟩,
    mpr := fun a =>
      And.casesOn a fun hprefix hnext j hj =>
        Or.casesOn (lt_or_eq_of_le (Nat.le_of_lt_succ hj)) (fun hlt => hprefix j hlt) fun heq =>
          Eq.mpr (id (congr (congrArg Eq (congrArg (⇑σ) (Fin.ext heq))) (congrArg (⇑τ) (Fin.ext heq)))) hnext }
theorem Luce.sum_mass_prefix_next : ∀ {n : ℕ} (w : Luce.Weights n) (σ : Equiv.Perm (Fin n)) (k i : Fin n),
  (∑ τ, if Luce.prefixAgrees σ τ ↑k ∧ τ k = i then w.mass τ else 0) =
    w.choice (Luce.remaining σ k) i * Luce.prefixMass w σ ↑k :=
fun {n} w σ k i =>
  if havailable : k ≤ (Equiv.symm σ) i then
    Exists.casesOn (Luce.exists_prefixAgrees_next_eq σ k i havailable) fun ρ h =>
      And.casesOn h fun hσρ hρk =>
        have heq := fun τ =>
          Eq.mpr
            (id
              (congrArg (fun _a => Luce.prefixAgrees σ τ ↑k ∧ τ k = i ↔ _a)
                (propext (Luce.prefixAgrees_succ_iff ρ τ k))))
            {
              mp := fun a =>
                And.casesOn a fun hστ hτk =>
                  ⟨fun j hj => Eq.trans (Eq.symm (hσρ j hj)) (hστ j hj), Eq.trans hρk (Eq.symm hτk)⟩,
              mpr := fun a =>
                And.casesOn a fun hρτ hτk => ⟨fun j hj => Eq.trans (hσρ j hj) (hρτ j hj), Eq.trans (Eq.symm hτk) hρk⟩ };
        Eq.mpr
          (id
            (congrFun'
              (congrArg Eq
                (Finset.sum_congr (Eq.refl Finset.univ) fun x a =>
                  ite_congr ((fun τ => propext (heq τ)) x) (fun a => Eq.refl (w.mass x)) fun a => Eq.refl 0))
              (w.choice (Luce.remaining σ k) i * Luce.prefixMass w σ ↑k)))
          (Eq.mpr
            (id
              (congrArg (fun _a => _a = w.choice (Luce.remaining σ k) i * Luce.prefixMass w σ ↑k)
                (Luce.sum_mass_prefix w ρ (↑k + 1) (Nat.succ_le_of_lt k.isLt))))
            (Eq.mpr
              (id
                (congrArg (fun _a => _a = w.choice (Luce.remaining σ k) i * Luce.prefixMass w σ ↑k)
                  (Luce.prefixMass_succ w ρ k)))
              (Eq.mpr
                (id
                  (congrArg
                    (fun _a =>
                      Luce.prefixMass w ρ ↑k * (w.rate _a / w.total (Luce.remaining ρ k)) =
                        w.choice (Luce.remaining σ k) i * Luce.prefixMass w σ ↑k)
                    hρk))
                (Eq.mpr
                  (id
                    (congrArg
                      (fun _a =>
                        _a * (w.rate i / w.total (Luce.remaining ρ k)) =
                          w.choice (Luce.remaining σ k) i * Luce.prefixMass w σ ↑k)
                      (Eq.symm (Luce.prefixMass_eq_of_prefix_agreement w σ ρ (↑k) hσρ))))
                  (Eq.mpr
                    (id
                      (congrArg
                        (fun _a =>
                          Luce.prefixMass w σ ↑k * (w.rate i / w.total _a) =
                            w.choice (Luce.remaining σ k) i * Luce.prefixMass w σ ↑k)
                        (Eq.symm (Luce.remaining_eq_of_prefix_agreement σ ρ k hσρ))))
                    (have hchoice :=
                      if_pos
                        (Eq.mpr
                          (id
                            (Eq.trans Luce.sum_mass_prefix_next._simp_1_1
                              (Eq.trans
                                (congrFun' (congrArg And (Luce.sum_mass_prefix_next._simp_1_2 i))
                                  (k ≤ (Equiv.symm σ) i))
                                (true_and (k ≤ (Equiv.symm σ) i)))))
                          havailable);
                    Eq.mpr
                      (id
                        (congrArg
                          (fun _a =>
                            Luce.prefixMass w σ ↑k * (w.rate i / w.total (Luce.remaining σ k)) =
                              _a * Luce.prefixMass w σ ↑k)
                          hchoice))
                      (Eq.mpr
                        (id
                          (congrArg (fun _a => _a = w.rate i / w.total (Luce.remaining σ k) * Luce.prefixMass w σ ↑k)
