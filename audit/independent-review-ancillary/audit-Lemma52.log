structure Luce.Weights (n : ℕ) : Type
number of parameters: 1
fields:
  Luce.Weights.rate : Fin n → ℝ
  Luce.Weights.positive : ∀ (i : Fin n), 0 < self.rate i
constructor:
  Luce.Weights.mk {n : ℕ} (rate : Fin n → ℝ) (positive : ∀ (i : Fin n), 0 < rate i) : Luce.Weights n
@[reducible] def Luce.WeightArray : Type :=
(n : ℕ) → Luce.Weights n
def Luce.NormalizedWeights : Luce.WeightArray → Prop :=
fun w => ∀ (n : ℕ), 0 < n → 1 / ↑n * ∑ i, (w n).rate i = 1
def Luce.ProfileLimit : Luce.WeightArray → (ℝ → ℝ) → Prop :=
fun w f =>
  MeasureTheory.NullMeasurable f Luce.profileMeasure ∧ (∀ x ∈ Set.Ioo 0 1, 0 < f x) ∧ Luce.ProfileL1Convergence w f
def Luce.ProfileL1Convergence : Luce.WeightArray → (ℝ → ℝ) → Prop :=
fun w f =>
  Filter.Tendsto (fun n => MeasureTheory.eLpNorm (fun x => Luce.stepProfile w n x - f x) 1 Luce.profileMeasure)
    Filter.atTop (nhds 0)
def Luce.stepProfile : Luce.WeightArray → ℕ → ℝ → ℝ :=
fun w n x => ∑ i, if ↑↑i / ↑n < x ∧ x ≤ (↑↑i + 1) / ↑n then (w n).rate i else 0
def Luce.profileMeasure : MeasureTheory.Measure ℝ :=
MeasureTheory.volume.restrict (Set.Ioo 0 1)
def Luce.exponentialRace : {n : ℕ} → Luce.Weights n → MeasureTheory.Measure (Fin n → ℝ) :=
fun {n} w => MeasureTheory.Measure.pi fun i => ProbabilityTheory.expMeasure (w.rate i)
def Luce.raceRank : {n : ℕ} → (Fin n → ℝ) → Fin n → ℕ :=
fun {n} times i => 1 + {j | times j < times i}.card
def Luce.cyclicRaceSum : {n r : ℕ} → Luce.Weights n → ℝ → Equiv.Perm (Fin r) → ((Fin r → ℝ) → ℝ) → ℝ :=
fun {n r} w α τ g =>
  ∑ i,
    if ∀ (a : Fin r), ↑↑(i a) + 1 ≤ α * ↑n then
      (g fun a => (↑↑(i a) + 1) / ↑n) *
        (Luce.exponentialRace w).real {E | ∀ (a : Fin r), Luce.raceRank E (i a) = ↑(i (τ a)) + 1}
    else 0
def Luce.cyclicBulkCube : (r : ℕ) → ℝ → Set (Fin r → ℝ) :=
fun r α => Set.univ.pi fun x => Set.Icc 0 α
def Luce.cyclicProfileDensity : (ℝ → ℝ) → ℝ → ℝ → ℝ :=
fun f x y =>
  Luce.rateKernel (Luce.profileQuantile Luce.profileMeasure f y) (f x) /
    Luce.profileD Luce.profileMeasure f (Luce.profileQuantile Luce.profileMeasure f y)
def Luce.profileQuantile.{u_1} : {Ω : Type u_1} →
  [inst : MeasurableSpace Ω] → MeasureTheory.Measure Ω → (Ω → ℝ) → ℝ → ℝ :=
fun {Ω} [MeasurableSpace Ω] μ f x => Function.invFunOn (Luce.profileF μ f) (Set.Ici 0) x
def Luce.profileF.{u_1} : {Ω : Type u_1} → [inst : MeasurableSpace Ω] → MeasureTheory.Measure Ω → (Ω → ℝ) → ℝ → ℝ :=
fun {Ω} [MeasurableSpace Ω] μ f t => 1 - Luce.profileH μ f t
def Luce.profileH.{u_1} : {Ω : Type u_1} → [inst : MeasurableSpace Ω] → MeasureTheory.Measure Ω → (Ω → ℝ) → ℝ → ℝ :=
fun {Ω} [MeasurableSpace Ω] μ f t => ∫ (x : Ω), Luce.survivalKernel t (f x) ∂μ
def Luce.profileD.{u_1} : {Ω : Type u_1} → [inst : MeasurableSpace Ω] → MeasureTheory.Measure Ω → (Ω → ℝ) → ℝ → ℝ :=
fun {Ω} [MeasurableSpace Ω] μ f t => ∫ (x : Ω), Luce.rateKernel t (f x) ∂μ
def Luce.rateKernel : ℝ → ℝ → ℝ :=
fun t a => a * Luce.survivalKernel t a
def Luce.survivalKernel : ℝ → ℝ → ℝ :=
fun t a => Real.exp (-t * a)
def Luce.finiteCyclicDensity : {n : ℕ} → Luce.Weights n → (ℝ → ℝ) → Fin n → Fin n → ℝ :=
fun {n} w f i j =>
  Luce.rateKernel (Luce.profileQuantile Luce.profileMeasure f ((↑↑j + 1) / ↑n)) (w.rate i) /
    Luce.profileD Luce.profileMeasure f (Luce.profileQuantile Luce.profileMeasure f ((↑↑j + 1) / ↑n))
def Luce.ValidMarkedGapConfiguration : {n r : ℕ} →
  Luce.Weights n →
    ℝ →
      ℝ →
        (removed : Finset (Fin n)) →
          (Fin r → Fin n) → (Fin r → Fin n) → (Fin r → Fin (Finset.univ \ removed).card) → Prop :=
fun {n r} w α M removed u j q =>
  removed.card ≤ r ∧ ∀ (a : Fin r), ↑(q a) + ↑a = ↑(j a) ∧ ↑↑(j a) + 1 ≤ α * ↑n ∧ w.rate (u a) ≤ M
structure Luce.MarkedGapIndexData (n r : ℕ) : Type
number of parameters: 2
fields:
  Luce.MarkedGapIndexData.removed : Finset (Fin n)
  Luce.MarkedGapIndexData.labels : Fin r → Fin n
  Luce.MarkedGapIndexData.ranks : Fin r → Fin n
  Luce.MarkedGapIndexData.gaps : Fin r ↪ Fin (Finset.univ \ self.removed).card
constructor:
  Luce.MarkedGapIndexData.mk {n r : ℕ} (removed : Finset (Fin n)) (labels ranks : Fin r → Fin n)
    (gaps : Fin r ↪ Fin (Finset.univ \ removed).card) : Luce.MarkedGapIndexData n r
