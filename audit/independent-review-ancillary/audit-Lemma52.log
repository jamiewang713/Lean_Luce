                    (@Pi.topologicalSpace (Fin r) (fun a => Real) fun i =>
                      @UniformSpace.toTopologicalSpace Real
                        (@PseudoMetricSpace.toUniformSpace Real Real.pseudoMetricSpace))
                    (@UniformSpace.toTopologicalSpace Real
                      (@PseudoMetricSpace.toUniformSpace Real Real.pseudoMetricSpace))
                    g (Luce.cyclicBulkCube r α) →
                  @Filter.Tendsto Nat Real (fun n => @Luce.cyclicRaceSum n r (w n) α τ g)
                    (@Filter.atTop Nat Nat.instPreorder)
                    (@nhds Real
                      (@UniformSpace.toTopologicalSpace Real
                        (@PseudoMetricSpace.toUniformSpace Real Real.pseudoMetricSpace))
                      (@MeasureTheory.integral (Fin r → Real) Real Real.normedAddCommGroup
                        (@InnerProductSpace.toNormedSpace Real Real Real.instRCLike
                          (@NormedAddCommGroup.toSeminormedAddCommGroup Real Real.normedAddCommGroup)
                          (@RCLike.toInnerProductSpaceReal Real Real.instRCLike))
                        (@MeasureTheory.MeasureSpace.toMeasurableSpace (Fin r → Real)
                          (@MeasureTheory.MeasureSpace.pi (Fin r) (Fin.fintype r) (fun a => Real) fun i =>
                            Real.measureSpace))
                        (@MeasureTheory.Measure.restrict (Fin r → Real)
                          (@MeasureTheory.MeasureSpace.toMeasurableSpace (Fin r → Real)
                            (@MeasureTheory.MeasureSpace.pi (Fin r) (Fin.fintype r) (fun a => Real) fun i =>
                              Real.measureSpace))
                          (@MeasureTheory.volume (Fin r → Real)
                            (@MeasureTheory.MeasureSpace.pi (Fin r) (Fin.fintype r) (fun a => Real) fun i =>
                              Real.measureSpace))
                          (Luce.cyclicBulkCube r α))
                        fun x =>
                        @HMul.hMul Real Real Real (@instHMul Real Real.instMul) (g x)
