                                        (@Function.instFunLikeEmbedding (Fin r) (Fin n)) j a)))
                                  (@OfNat.ofNat Real (nat_lit 1) (@One.toOfNat1 Real Real.instOne)))
                                (@HMul.hMul Real Real Real (@instHMul Real Real.instMul) α
                                  (@Nat.cast Real Real.instNatCast n))) →
