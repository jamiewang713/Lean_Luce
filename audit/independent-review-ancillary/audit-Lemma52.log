                                        (@DFunLike.coe (Function.Embedding (Fin r) (Fin n)) (Fin r) (fun x => Fin n)
                                          (@Function.instFunLikeEmbedding (Fin r) (Fin n)) i a))
                                      (@HAdd.hAdd Nat Nat Nat (@instHAdd Nat instAddNat)
                                        (@Fin.val n
                                          (@DFunLike.coe (Function.Embedding (Fin r) (Fin n)) (Fin r) (fun x => Fin n)
                                            (@Function.instFunLikeEmbedding (Fin r) (Fin n)) j a))
                                        (@OfNat.ofNat Nat (nat_lit 1) (instOfNatNat (nat_lit 1))))))
