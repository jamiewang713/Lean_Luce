def Luce.tailFixedPointCount : {n : ℕ} → (Fin n → ℝ) → ℝ → ℕ :=
fun {n} e α => {k | α * ↑n < ↑↑k + 1 ∧ Luce.rankOf e k = ↑k + 1}.card
theorem Luce.measurable_tailFixedPointCount : ∀ {n : ℕ} (α : ℝ), Measurable fun e => Luce.tailFixedPointCount e α :=
fun {n} α =>
  Eq.mpr
    (id
      (congrArg Measurable
        (funext fun e => Finset.card_filter (fun i => α * ↑n < ↑↑i + 1 ∧ Luce.rankOf e i = ↑i + 1) Finset.univ)))
    (Finset.measurable_sum Finset.univ fun k a =>
      have hspatial :=
        if h : α * ↑n < ↑↑k + 1 then
          of_eq_true
            (Eq.trans (congrArg MeasurableSet (congrArg Set.ofPred (funext fun e => eq_true h)))
              MeasurableSet.univ._simp_1)
        else
          of_eq_true
            (Eq.trans (congrArg MeasurableSet (congrArg Set.ofPred (funext fun e => eq_false h)))
              MeasurableSet.empty._simp_1);
      Measurable.ite (MeasurableSet.inter hspatial (Luce.measurable_rankOf k (measurableSet_singleton (↑k + 1))))
        measurable_const measurable_const)
theorem Luce.tailFixedPointCount_le : ∀ {n : ℕ} (e : Fin n → ℝ) (α : ℝ), Luce.tailFixedPointCount e α ≤ n :=
fun {n} e α =>
