theorem Luce.endpointAssumption_epsilon_estimate : ∀ (w : Luce.WeightArray),
  Luce.NormalizedWeights w →
    Luce.EndpointAssumption w →
      ∃ γ,
        0 < γ ∧
          ∃ δ,
            0 < δ ∧
              ∀ (ε : ℝ),
                0 < ε →
                  ε < δ →
                    limsup (Luce.epsilonTailExpectation (fun n => w (n + 1)) ε) atTop ≤ 2 ^ (1 + γ / 2) * ε ^ (γ / 4) :=
fun w hnorm hend =>
  Exists.casesOn (Luce.EndpointAssumption.eventually_terminal_rates hend) fun γ h =>
    Exists.casesOn h fun ε₀ h =>
      And.casesOn h fun hγ right =>
        And.casesOn right fun hε₀ hrate =>
          Exists.intro γ
            ⟨hγ,
              Luce.endpoint_epsilon_estimate (fun n => w (n + 1)) (Luce.NormalizedWeights.sum_rates_succ hnorm) hγ hε₀
                hrate⟩
