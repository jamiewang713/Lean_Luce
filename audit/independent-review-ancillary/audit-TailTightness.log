                        (Eq.mp (congrFun' (congrArg Eq (Luce.rankOf_eq_raceRank_for_tail e k)) (↑k + 1)) hkfixed)⟩)
                  hcandidate))))
theorem Luce.NormalizedWeights.sum_rates_succ : ∀ {w : Luce.WeightArray},
  Luce.NormalizedWeights w → ∀ (n : ℕ), ∑ i, (w (n + 1)).rate i = ↑(n + 1) :=
fun {w} hnorm n =>
  have h := hnorm (n + 1) (Nat.succ_pos n);
  have hn :=
    ne_of_gt
      (Nat.cast_pos'.mpr
        (Right.add_pos_of_nonneg_of_pos zero_le
          (Mathlib.Meta.Positivity.pos_of_isNat (Mathlib.Meta.NormNum.isNat_ofNat ℕ (Eq.refl 1))
            (Eq.refl (Nat.ble 1 1)))));
  have hdiv :=
    Eq.mpr (id (congrFun' (congrArg Eq (div_eq_mul_inv (∑ i, (w (n + 1)).rate i) ↑(n + 1))) 1))
      (Eq.mp
        (congrFun'
          (congrArg Eq
            (Eq.trans
              (congrFun'
                (congrArg HMul.hMul
                  (Eq.trans (div_eq_mul_inv 1 ↑(n + 1)) (Eq.trans (mul_comm 1 (↑(n + 1))⁻¹) (mul_one (↑(n + 1))⁻¹))))
                (∑ i, (w (n + 1)).rate i))
              (mul_comm (↑(n + 1))⁻¹ (∑ i, (w (n + 1)).rate i))))
          1)
        h);
  Eq.mp (congrArg (Eq (∑ i, (w (n + 1)).rate i)) (one_mul ↑(n + 1))) ((div_eq_iff hn).mp hdiv)
