            have hε₁ε₀ := min_le_left ε₀ (1 / 2);
            have hε₁one :=
              LE.le.trans (min_le_right ε₀ (1 / 2))
                (Mathlib.Meta.NormNum.isRat_le_true
                  (Mathlib.Meta.NormNum.IsNNRat.to_isRat
                    (Mathlib.Meta.NormNum.isNNRat_div
