theorem Luce.tailFixedPointCount_eq_terminalFixedPointCount : ∀ (n : ℕ) (e : Fin (n + 1) → ℝ) {ε : ℝ},
  0 < ε →
    ε < 1 →
      Luce.tailFixedPointCount e (1 - ε) = Luce.terminalFixedPointCount (Luce.terminalCandidate n) ⌈ε * (↑n + 1)⌉₊ e :=
fun n e {ε} _hε hεone =>
  have hM :=
    Nat.ceil_le.mpr
      (Eq.mpr
        (id (congrArg (LE.le (ε * (↑n + 1))) (Eq.trans (Nat.cast_add n 1) (congrArg (HAdd.hAdd ↑n) Nat.cast_one))))
        (mul_le_of_le_one_left
          (le_of_lt
            (Right.add_pos_of_nonneg_of_pos (Nat.cast_nonneg' n)
              (Mathlib.Meta.Positivity.pos_of_isNat (Mathlib.Meta.NormNum.isNat_ofNat ℝ Nat.cast_one)
                (Eq.refl (Nat.ble 1 1)))))
          (LT.lt.le hεone)));
  id
    (id
      (Eq.symm
        (Finset.card_bij (fun m x => Luce.terminalCandidate n m)
          (fun m hm =>
            And.casesOn (Finset.mem_filter.mp hm) fun hmrange hmfixed =>
              And.casesOn (Finset.mem_Icc.mp hmrange) fun hmpos hmM =>
                have hmN := LE.le.trans hmM hM;
                have hval := Luce.terminalCandidate_val_add hmpos hmN;
                Finset.mem_filter.mpr
                  ⟨Finset.mem_univ (Luce.terminalCandidate n m),
                    ⟨(Luce.spatial_tail_iff_terminal_index (Luce.terminalCandidate n m) ε).mpr
                        (have hindex :=
                          Decidable.byContradiction fun a =>
                            Luce.tailFixedPointCount_eq_terminalFixedPointCount._proof_1_1 n e m hmpos hval a;
                        Eq.mpr (id (congrArg (fun _a => _a ≤ ⌈ε * (↑n + 1)⌉₊) hindex)) hmM),
                      Eq.mpr
                        (id
                          (congrFun' (congrArg Eq (Luce.rankOf_eq_raceRank_for_tail e (Luce.terminalCandidate n m)))
                            (↑(Luce.terminalCandidate n m) + 1)))
                        hmfixed⟩⟩)
          (fun m₁ hm₁ m₂ hm₂ heq =>
            have hrange₁ := Finset.mem_Icc.mp (Finset.mem_filter.mp hm₁).left;
            have hrange₂ := Finset.mem_Icc.mp (Finset.mem_filter.mp hm₂).left;
            have hval₁ := Luce.terminalCandidate_val_add hrange₁.left (LE.le.trans hrange₁.right hM);
            have hval₂ := Luce.terminalCandidate_val_add hrange₂.left (LE.le.trans hrange₂.right hM);
            have hvaleq := congrArg Fin.val heq;
            Decidable.byContradiction fun a =>
              Luce.tailFixedPointCount_eq_terminalFixedPointCount._proof_1_2 n m₁ m₂ heq hval₁ hval₂ a)
          fun k hk =>
          And.casesOn (Finset.mem_filter.mp hk) fun left right =>
            And.casesOn right fun hkspace hkfixed =>
              have hmpos :=
                Decidable.byContradiction fun a =>
                  Luce.tailFixedPointCount_eq_terminalFixedPointCount._proof_1_3 n e k a;
              have hmN := Nat.sub_le (n + 1) ↑k;
              have hmM := (Luce.spatial_tail_iff_terminal_index k ε).mp hkspace;
              have hcandidate :=
                Fin.ext
