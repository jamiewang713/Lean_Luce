theorem Luce.tail_probability_le_epsilonTailExpectation.{u_1} : ∀ {Ω : Type u_1} [inst : MeasurableSpace Ω]
  (P : Measure Ω) [IsProbabilityMeasure P] (w : Luce.WeightArray) (n : ℕ) (E : Fin (n + 1) → Ω → ℝ),
  (∀ (i : Fin (n + 1)), HasLaw (E i) (expMeasure ((w (n + 1)).rate i)) P) →
    iIndepFun E P →
      ∀ {ε : ℝ},
        0 < ε →
          ε < 1 →
            P.real {ω | 0 < Luce.tailFixedPointCount (fun i => E i ω) (1 - ε)} ≤
              Luce.epsilonTailExpectation (fun n => w (n + 1)) ε n :=
fun {Ω} [MeasurableSpace Ω] P [IsProbabilityMeasure P] w n E hLaw hIndependent {ε} hε hεone =>
  Eq.mpr
    (id
      (congrArg (fun _a => _a ≤ Luce.epsilonTailExpectation (fun n => w (n + 1)) ε n)
        (Luce.tailFixedPointCount_probability_eq P (w (n + 1)) E hLaw hIndependent (1 - ε))))
    (have h := Luce.tailFixedPointCount_probability_le_expectation (w (n + 1)) (1 - ε);
    Eq.mpr
      (id
        (congrFun'
          (congrArg LE.le
            (congrArg (Luce.exponentialRace (w (n + 1))).real
              (congrArg Set.ofPred
                (funext fun e =>
                  congrArg (LT.lt 0)
                    ((fun x_0 => (fun x_0 => Luce.tailFixedPointCount_eq_terminalFixedPointCount n x_0 hε hεone) x_0)
                      e)))))
          (∫ (clocks : Fin (n + 1) → ℝ),
            ↑(Luce.terminalFixedPointCount (Luce.terminalCandidate n) ⌈ε * (↑n + 1)⌉₊
                clocks) ∂Luce.exponentialRace (w (n + 1)))))
      (Eq.mp
        (congr
          (congrArg LE.le
            (congrArg (Luce.exponentialRace (w (n + 1))).real
              (congrArg Set.ofPred
                (funext fun e =>
                  congrArg (LT.lt 0)
                    ((fun x_0 => (fun x_0 => Luce.tailFixedPointCount_eq_terminalFixedPointCount n x_0 hε hεone) x_0)
                      e)))))
          (congrArg (integral (Luce.exponentialRace (w (n + 1))))
            (funext fun e =>
              congrArg Nat.cast
                ((fun x_0 => (fun x_0 => Luce.tailFixedPointCount_eq_terminalFixedPointCount n x_0 hε hεone) x_0) e))))
        h))
theorem Luce.tail_fixed_point_tightness.{u} : ∀ (Ω : ℕ → Type u) [inst : (n : ℕ) → MeasurableSpace (Ω n)]
  (P : (n : ℕ) → Measure (Ω n)) [∀ (n : ℕ), IsProbabilityMeasure (P n)] (w : Luce.WeightArray),
  Luce.NormalizedWeights w →
    Luce.EndpointAssumption w →
      ∀ (E : (n : ℕ) → Fin n → Ω n → ℝ),
        (∀ (n : ℕ) (i : Fin n), HasLaw (E n i) (expMeasure ((w n).rate i)) (P n)) →
          (∀ (n : ℕ), iIndepFun (E n) (P n)) →
            Tendsto
              (fun α => limsup (fun n => (P n).real {ω | 0 < Luce.tailFixedPointCount (fun i => E n i ω) α}) atTop)
              (𝓝[<] 1) (𝓝 0) :=
fun Ω [(n : ℕ) → MeasurableSpace (Ω n)] P [∀ (n : ℕ), IsProbabilityMeasure (P n)] w hnorm hend E hLaw hIndependent =>
  let p := fun α n => (P n).real {ω | 0 < Luce.tailFixedPointCount (fun i => E n i ω) α};
  have hp_nonneg := fun α n => measureReal_nonneg;
  have hp_bounded := fun α =>
    Exists.intro 1
      (have this := Eventually.of_forall fun n => measureReal_le_one;
      this);
  have hlim_nonneg := fun α =>
    le_limsup_of_frequently_le (Eventually.frequently (Eventually.of_forall (hp_nonneg α))) (hp_bounded α);
  Exists.casesOn (Luce.endpointAssumption_epsilon_estimate_bounded w hnorm hend) fun γ h =>
    And.casesOn h fun hγ right =>
      Exists.casesOn right fun δ h =>
        And.casesOn h fun hδ hestimate =>
          Luce.tendsto_zero_of_endpoint_power_bound (fun α => limsup (p α) atTop) hlim_nonneg hγ
            (lt_min hδ
              (Mathlib.Meta.NormNum.isNat_lt_true (Mathlib.Meta.NormNum.isNat_ofNat ℝ Nat.cast_zero)
                (Mathlib.Meta.NormNum.isNat_ofNat ℝ Nat.cast_one) (Eq.refl false)))
            fun ε hε hεδ =>
            have hεone := LT.lt.trans_le hεδ (min_le_right δ 1);
            And.casesOn (hestimate ε hε (LT.lt.trans_le hεδ (min_le_left δ 1))) fun hbounded hpower =>
              have hcomparison :=
                Eventually.of_forall fun n =>
                  Luce.tail_probability_le_epsilonTailExpectation (P (n + 1)) w n (E (n + 1)) (hLaw (n + 1))
                    (hIndependent (n + 1)) hε hεone;
              have hlim :=
                limsup_le_limsup hcomparison (isCoboundedUnder_le_of_le atTop fun n => hp_nonneg (1 - ε) (n + 1))
                  hbounded;
              LE.le.trans
                (Eq.mp
                  (congrArg (fun _a => _a ≤ limsup (Luce.epsilonTailExpectation (fun n => w (n + 1)) ε) atTop)
                    (limsup_nat_add (p (1 - ε)) 1))
                  hlim)
                hpower
