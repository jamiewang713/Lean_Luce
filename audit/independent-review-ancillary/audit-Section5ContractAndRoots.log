def Luce.Section5.bulkCycleCount : {n : ℕ} → Equiv.Perm (Fin n) → ℝ → ℕ → ℕ :=
fun {n} R a k => Luce.Section5.cycleCountWithin R (Luce.Section5.bulkCycleLabelSet n a) k
def Luce.Section5.cycleCountWithin.{u_1} : {α : Type u_1} →
  [Fintype α] → [DecidableEq α] → Equiv.Perm α → Finset α → ℕ → ℕ :=
fun {α} [Fintype α] [DecidableEq α] R S k => (Luce.Section5.cycleOrbitsWithin R S k).card
def Luce.Section5.cycleOrbitsWithin.{u_1} : {α : Type u_1} →
  [Fintype α] → [DecidableEq α] → Equiv.Perm α → Finset α → ℕ → Finset (Cycle α) :=
