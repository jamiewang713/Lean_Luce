def Luce.cycleTraceIntegrand : (ℝ → ℝ) → (k : ℕ) → (Fin (k + 1) → ℝ) → ℝ :=
fun f k x => ∏ a, Luce.cyclicProfileDensity f (x a) (x ((finRotate (k + 1)) a))
def Luce.cycleTraceIntensity : (ℝ → ℝ) → ℕ → ℝ :=
fun f k => 1 / (↑k + 1) * ∫ (x : Fin (k + 1) → ℝ), Luce.cycleTraceIntegrand f k x ∂Luce.cyclicProfileMeasure (k + 1)
def Luce.cycleCountVector : {n : ℕ} → (L : ℕ) → Equiv.Perm (Fin n) → Fin L → ℕ :=
fun {n} L R k => Luce.Section5.cycleCount R ↑k
def Luce.cycleVectorPoissonLaw : (ℝ → ℝ) → (L : ℕ) → MeasureTheory.Measure (Fin L → ℕ) :=
fun f L => MeasureTheory.Measure.pi fun k => ProbabilityTheory.poissonMeasure (Luce.cycleTraceIntensity f ↑k).toNNReal
def Luce.cycleVectorTotalVariation : {L : ℕ} →
  MeasureTheory.Measure (Fin L → ℕ) → MeasureTheory.Measure (Fin L → ℕ) → ℝ :=
fun {L} μ ν => sSup {r | ∃ A, r = |μ.real A - ν.real A|}
