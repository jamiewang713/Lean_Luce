'Luce.section5_proposition54' depends on axioms: [propext, Classical.choice, Quot.sound]
'Luce.ProfileLimit.low_rate_cycles_vanish' depends on axioms: [propext, Classical.choice, Quot.sound]
'Luce.ProfileLimit.bounded_cycle_probability_uniform' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem Luce.section5_proposition54 : ∀ (w : Luce.WeightArray) (f : ℝ → ℝ),
  Luce.NormalizedWeights w →
    Luce.ProfileLimit w f →
      Luce.EndpointAssumption w →
        ∀ (L : ℕ),
          Filter.Tendsto (fun M => Filter.limsup (fun n => Luce.highCycleExpectation w L n M) Filter.atTop) Filter.atTop
              (nhds 0) ∧
            Filter.Tendsto (fun δ => Filter.limsup (fun n => Luce.lowCycleExpectation w L n δ) Filter.atTop)
              (nhdsWithin 0 (Set.Ioi 0)) (nhds 0) :=
fun w f hnorm hf hend L =>
  ⟨Luce.ProfileLimit.high_rate_cycles_vanish hf hnorm L, Luce.ProfileLimit.low_rate_cycles_vanish hf hnorm hend L⟩
