def Luce.interiorLowCycleExpectation : Luce.WeightArray → ℕ → ℕ → ℝ → ℝ → ℝ :=
fun w L n α δ =>
  ∫ (clocks : Fin n → ℝ),
    ↑(Luce.shortCycleVertexCount (Luce.raceRankPermutation clocks) L
        {v | (w n).rate v < δ ∧ ↑↑v + 1 ≤ α * ↑n}) ∂Luce.exponentialRace (w n)
def Luce.shortCycleVertexCount : {n : ℕ} → Equiv.Perm (Fin n) → ℕ → Finset (Fin n) → ℕ :=
fun {n} R L S => {v ∈ S | ∃ k, Function.minimalPeriod (⇑R) v = ↑k + 1}.card
def Luce.lowRateDensity : Luce.WeightArray → ℕ → ℝ → ℝ :=
fun w n δ => ↑{i | (w n).rate i < δ}.card / ↑n
def Luce.highCycleExpectation : Luce.WeightArray → ℕ → ℕ → ℝ → ℝ :=
fun w L n M =>
  ∫ (clocks : Fin n → ℝ),
    ↑(Luce.shortCycleVertexCount (Luce.raceRankPermutation clocks) L {v | M < (w n).rate v}) ∂Luce.exponentialRace (w n)
