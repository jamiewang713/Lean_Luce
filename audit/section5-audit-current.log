        ∃ d η,
          And (@LT.lt Real Real.instLT (@OfNat.ofNat Real (nat_lit 0) (@Zero.toOfNat0 Real Real.instZero)) d)
            (And (@LT.lt Real Real.instLT (@OfNat.ofNat Real (nat_lit 0) (@Zero.toOfNat0 Real Real.instZero)) η)
              (And
                (@Filter.Eventually Nat
                  (fun n =>
                    @LE.le Real Real.instLE
                      (@HMul.hMul Real Real Real (@instHMul Real Real.instMul)
                        (@HAdd.hAdd Real Real Real (@instHAdd Real Real.instAdd) α
                          (@HMul.hMul Real Real Real (@instHMul Real Real.instMul)
                            (@OfNat.ofNat Real (nat_lit 2) (@instOfNatAtLeastTwo Real (nat_lit 2) Real.instNatCast ⋯))
                            η))
                        (@Nat.cast Real Real.instNatCast n))
                      (@Nat.cast Real Real.instNatCast (@Finset.card (Fin n) (Luce.moderateReservoir w n d))))
                  (@Filter.atTop Nat Nat.instPreorder))
                (∀ (m : Nat),
                  @Filter.Eventually Nat
                    (fun n =>
                      ∀ (removed : Finset (Fin n)),
                        @LE.le Real Real.instLE (@Nat.cast Real Real.instNatCast (@Finset.card (Fin n) removed))
                            (@HAdd.hAdd Real Real Real (@instHAdd Real Real.instAdd)
                              (@HMul.hMul Real Real Real (@instHMul Real Real.instMul) α
                                (@Nat.cast Real Real.instNatCast n))
                              (@Nat.cast Real Real.instNatCast m)) →
                          @LE.le Real Real.instLE
                            (@HMul.hMul Real Real Real (@instHMul Real Real.instMul)
                              (@HMul.hMul Real Real Real (@instHMul Real Real.instMul) d η)
                              (@Nat.cast Real Real.instNatCast n))
                            (∑
                              i ∈
                                @sdiff (Finset (Fin n)) (@Finset.instSDiff (Fin n) (instDecidableEqFin n))
                                  (@Finset.univ (Fin n) (Fin.fintype n)) removed,
                              @Luce.Weights.rate n (w n) i))
                    (@Filter.atTop Nat Nat.instPreorder))))
