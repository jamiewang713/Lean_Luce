structure Luce.Weights (n : ℕ) : Type
number of parameters: 1
fields:
  Luce.Weights.rate : Fin n → ℝ
  Luce.Weights.positive : ∀ (i : Fin n), 0 < self.rate i
constructor:
  Luce.Weights.mk {n : ℕ} (rate : Fin n → ℝ) (positive : ∀ (i : Fin n), 0 < rate i) : Luce.Weights n
@[reducible] def Luce.WeightArray : Type :=
(n : ℕ) → Luce.Weights n
def Luce.NormalizedWeights : Luce.WeightArray → Prop :=
fun w => ∀ (n : ℕ), 0 < n → 1 / ↑n * ∑ i, (w n).rate i = 1
def Luce.ProfileLimit : Luce.WeightArray → (ℝ → ℝ) → Prop :=
fun w f =>
  MeasureTheory.NullMeasurable f Luce.profileMeasure ∧ (∀ x ∈ Set.Ioo 0 1, 0 < f x) ∧ Luce.ProfileL1Convergence w f
def Luce.ProfileL1Convergence : Luce.WeightArray → (ℝ → ℝ) → Prop :=
fun w f =>
  Filter.Tendsto (fun n => MeasureTheory.eLpNorm (fun x => Luce.stepProfile w n x - f x) 1 Luce.profileMeasure)
    Filter.atTop (nhds 0)
def Luce.EndpointAssumption : Luce.WeightArray → Prop :=
fun w => ∃ γ ε₀ n₀, 0 < γ ∧ 0 < ε₀ ∧ ∀ (n : ℕ), n₀ ≤ n → ∀ (k : Fin n), (1 - ε₀) * ↑n ≤ ↑↑k + 1 → γ ≤ (w n).rate k
def Luce.profileMeasure : MeasureTheory.Measure ℝ :=
MeasureTheory.volume.restrict (Set.Ioo 0 1)
def Luce.stepProfile : Luce.WeightArray → ℕ → ℝ → ℝ :=
fun w n x => ∑ i, if ↑↑i / ↑n < x ∧ x ≤ (↑↑i + 1) / ↑n then (w n).rate i else 0
def Luce.moderateReservoir : Luce.WeightArray → (n : ℕ) → ℝ → Finset (Fin n) :=
fun w n d => {i | d ≤ (w n).rate i}
def Luce.exponentialRace : {n : ℕ} → Luce.Weights n → MeasureTheory.Measure (Fin n → ℝ) :=
fun {n} w => MeasureTheory.Measure.pi fun i => ProbabilityTheory.expMeasure (w.rate i)
def Luce.pairedExponentialRace : {n : ℕ} → Luce.Weights n → MeasureTheory.Measure (Fin n → ℝ × ℝ) :=
fun {n} w =>
  MeasureTheory.Measure.pi fun i =>
    (ProbabilityTheory.expMeasure (w.rate i)).prod (ProbabilityTheory.expMeasure (w.rate i))
def Luce.swapClockCopies : {n : ℕ} → Finset (Fin n) → (Fin n → ℝ × ℝ) → Fin n → ℝ × ℝ :=
fun {n} s c i => if i ∈ s then (c i).swap else c i
def Luce.clockBeforeCount : {n : ℕ} → (Fin n → ℝ) → ℝ → ℕ :=
fun {n} clocks t => {i | clocks i < t}.card
def Luce.GhostWindowByOrder : {n : ℕ} → (clocks : Fin n → ℝ) → Function.Injective clocks → ℕ → Fin n → ℝ → Prop :=
fun {n} clocks hinj ell j t =>
  (if hlower : ell < ↑j + 1 then Luce.arrivalTime clocks hinj ⟨↑j - ell, ⋯⟩ < t else 0 < t) ∧
    if hupper : ↑j + 1 + ell ≤ n then t < Luce.arrivalTime clocks hinj ⟨↑j + ell, ⋯⟩ else True
def Luce.GhostCountWindow : {n : ℕ} → ℕ → (Fin n → ℝ) → Fin n → ℝ → Prop :=
fun {n} ell old j t => 0 < t ∧ ↑j + 1 ≤ Luce.clockBeforeCount old t + ell ∧ Luce.clockBeforeCount old t < ↑j + 1 + ell
def Luce.ghostOrderKernel : {n : ℕ} → Luce.Weights n → ℕ → (Fin n → ℝ) → Fin n → Fin n → ENNReal :=
fun {n} w ell old i j =>
  if h : Function.Injective old then
    (ProbabilityTheory.expMeasure (w.rate i)) {t | Luce.GhostWindowByOrder old h ell j t}
  else 0
def Luce.ghostCountKernel : {n : ℕ} → Luce.Weights n → ℕ → (Fin n → ℝ) → Fin n → Fin n → ENNReal :=
fun {n} w ell old i j => (ProbabilityTheory.expMeasure (w.rate i)) {t | Luce.GhostCountWindow ell old j t}
def Luce.ghostEntry : {n : ℕ} → Luce.Weights n → ℕ → (Fin n → ℝ) → Fin n → Fin n → ℝ :=
fun {n} w ell old i j => (Luce.ghostOrderKernel w ell old i j).toReal
def Luce.MarkedRankCylinder : {n ell : ℕ} → (Fin ell → Fin n) → (Fin ell → Fin n) → (Fin n → ℝ) → Prop :=
fun {n ell} u j clocks => ∀ (a : Fin ell), Luce.raceRank clocks (u a) = ↑(j a) + 1
def Luce.ghostColumn : {n : ℕ} → Luce.Weights n → ℕ → (Fin n → ℝ) → Fin n → ℝ :=
fun {n} w ell old j => ∑ k, Luce.ghostEntry w ell old k j
def Luce.ghostPredecessorSum : {n : ℕ} → {m : ℕ} → Luce.Weights n → ℕ → Fin n → (Fin n → ℝ) → ENNReal :=
fun {n m} w ell v old =>
  ∑ u with Function.Injective u ∧ ∀ (a : Fin m), u a ≠ v,
    Luce.ghostColumnKernel w ell old (Fin.snoc u v 0) * Luce.insertionPathWeight (Luce.ghostOrderKernel w ell old) v u
def Luce.insertionPathWeight.{u_1} : {α : Type u_1} → {m : ℕ} → (α → α → ENNReal) → α → (Fin m → α) → ENNReal :=
fun {α} {m} p v u => ∏ a, p (u a) (Fin.snoc u v a.succ)
def Luce.predecessorConstant : ℕ → ℕ → ℕ :=
fun ell m => (2 * (ell + (m + 1) + 2) + 1) ^ (m + 1) + m * (2 * (ell + m + 2) + 1) ^ m
def Luce.highRateMass : Luce.WeightArray → ℕ → ℝ → ℝ :=
fun w n M => (∑ i with M < (w n).rate i, (w n).rate i) / ↑n
def Luce.raceRankPermutation : {n : ℕ} → (Fin n → ℝ) → Equiv.Perm (Fin n) :=
fun {n} clocks => if h : Function.Injective clocks then Luce.rankPermutation clocks h else Equiv.refl (Fin n)
def Luce.ghostCycleVertexSum : {n : ℕ} → Luce.Weights n → ℕ → Fin n → (Fin n → ℝ) → ℝ :=
fun {n} w k v old =>
  ∑ u with Function.Injective u ∧ ∀ (a : Fin k), u a ≠ v,
    Luce.ghostEntry w (k + 1) old v (Fin.snoc u v 0) * ∏ a, Luce.ghostEntry w (k + 1) old (u a) (Fin.snoc u v a.succ)
def Luce.shortCycleVertexCount : {n : ℕ} → Equiv.Perm (Fin n) → ℕ → Finset (Fin n) → ℕ :=
fun {n} R L S => {v ∈ S | ∃ k, Function.minimalPeriod (⇑R) v = ↑k + 1}.card
def Luce.highCycleConstant : ℕ → ℕ :=
fun L => 2 * ∑ k, Luce.predecessorConstant (↑k + 1) ↑k
def Luce.highCycleExpectation : Luce.WeightArray → ℕ → ℕ → ℝ → ℝ :=
fun w L n M =>
  ∫ (clocks : Fin n → ℝ),
    ↑(Luce.shortCycleVertexCount (Luce.raceRankPermutation clocks) L {v | M < (w n).rate v}) ∂Luce.exponentialRace (w n)
def Luce.deletedEmpiricalArrival : {n : ℕ} → Finset (Fin n) → (Fin n → ℝ) → ℝ → ℝ :=
fun {n} removed clocks t => (∑ i ∈ Finset.univ \ removed, Luce.arrivalAt t (clocks i)) / ↑n
def Luce.deletedEmpiricalRemainingGe : {n : ℕ} → Luce.Weights n → Finset (Fin n) → (Fin n → ℝ) → ℝ → ℝ :=
fun {n} w removed clocks t => (∑ i ∈ Finset.univ \ removed, if t ≤ clocks i then w.rate i else 0) / ↑n
def Luce.deletedEmpiricalRemaining : {n : ℕ} → Luce.Weights n → Finset (Fin n) → (Fin n → ℝ) → ℝ → ℝ :=
fun {n} w removed clocks t => (∑ i ∈ Finset.univ \ removed, if t < clocks i then w.rate i else 0) / ↑n
def Luce.lowRateDensity : Luce.WeightArray → ℕ → ℝ → ℝ :=
fun w n δ => ↑{i | (w n).rate i < δ}.card / ↑n
def Luce.ApproximatePermutationPath : {n m : ℕ} → Equiv.Perm (Fin n) → ℕ → Fin n → (Fin m → Fin n) → Prop :=
fun {n m} σ q v u => ∀ (a : Fin m), Luce.ApproximatePermutationEdge σ q (u a) (Fin.snoc u v a.succ)
def Luce.ApproximateClockPath : {n m : ℕ} → ℕ → Fin n → (Fin m → Fin n) → (Fin n → ℝ) → Prop :=
fun {n m} q v u c => ∀ (a : Fin m), (Luce.clockBeforeCount c (c (u a))).dist ↑(Fin.snoc u v a.succ) ≤ q
def Luce.Section5.IsRootedCycle.{u_1} : {α : Type u_1} → Equiv.Perm α → (k : ℕ) → (Fin (k + 1) ↪ α) → Prop :=
fun {α} R k t => (∀ (a : Fin k), R (t a.castSucc) = t a.succ) ∧ R (t (Fin.last k)) = t 0
@[reducible] def Luce.Section5.RootedCycle.{u_1} : {α : Type u_1} → Equiv.Perm α → ℕ → Type (max 0 u_1) :=
fun {α} R k => { t // Luce.Section5.IsRootedCycle R k t }
def Luce.Section5.cycleVertices.{u_1} : {α : Type u_1} → [Fintype α] → Equiv.Perm α → ℕ → Finset α :=
fun {α} [Fintype α] R k => {x | Function.minimalPeriod (⇑R) x = k + 1}
def Luce.Section5.cycleOrbits.{u_1} : {α : Type u_1} →
  [Fintype α] → [DecidableEq α] → Equiv.Perm α → ℕ → Finset (Cycle α) :=
fun {α} [Fintype α] [DecidableEq α] R k => Finset.image (Function.periodicOrbit ⇑R) (Luce.Section5.cycleVertices R k)
def Luce.Section5.cycleCount.{u_1} : {α : Type u_1} → [Fintype α] → [DecidableEq α] → Equiv.Perm α → ℕ → ℕ :=
fun {α} [Fintype α] [DecidableEq α] R k => (Luce.Section5.cycleOrbits R k).card
def Luce.Section5.cycleAssignmentWeight.{u_1} : {α : Type u_1} →
  [DecidableEq α] → Equiv.Perm α → (k : ℕ) → (Fin (k + 1) ↪ α) → ℝ :=
fun {α} [DecidableEq α] R k t =>
  (∏ a, if R (t a.castSucc) = t a.succ then 1 else 0) * if R (t (Fin.last k)) = t 0 then 1 else 0
@[reducible] def Luce.Section5.CycleCollection.{u_1} : {α : Type u_1} →
  [Fintype α] → [DecidableEq α] → Equiv.Perm α → (L : ℕ) → (Fin L → ℕ) → Type (max 0 u_1) :=
fun {α} [Fintype α] [DecidableEq α] R L m => (ℓ : Fin L) → Fin (m ℓ) ↪ ↥(Luce.Section5.cycleOrbits R ↑ℓ)
@[reducible] def Luce.Section5.CycleRoots.{u_1} : {α : Type u_1} →
  [inst : Fintype α] →
    [inst_1 : DecidableEq α] →
      {R : Equiv.Perm α} → {L : ℕ} → {m : Fin L → ℕ} → Luce.Section5.CycleCollection R L m → Type u_1 :=
fun {α} [Fintype α] [DecidableEq α] {R} {L} {m} C => (ℓ : Fin L) → (a : Fin (m ℓ)) → ↥(↑((C ℓ) a)).toFinset
@[reducible] def Luce.Section5.RootedCycleCollection.{u_1} : {α : Type u_1} →
  [Fintype α] → [DecidableEq α] → Equiv.Perm α → (L : ℕ) → (Fin L → ℕ) → Type u_1 :=
fun {α} [Fintype α] [DecidableEq α] R L m => (C : Luce.Section5.CycleCollection R L m) × Luce.Section5.CycleRoots C
