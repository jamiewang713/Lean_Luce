@Luce.ProfileLimit.moderate_reservoir : ∀ {w : Luce.WeightArray} {f : Real → Real},
  Luce.ProfileLimit w f →
    ∀ {α : Real},
      @LT.lt Real Real.instLT α (@OfNat.ofNat Real (nat_lit 1) (@One.toOfNat1 Real Real.instOne)) →
        ∃ d η,
          And (@LT.lt Real Real.instLT (@OfNat.ofNat Real (nat_lit 0) (@Zero.toOfNat0 Real Real.instZero)) d)
            (And (@LT.lt Real Real.instLT (@OfNat.ofNat Real (nat_lit 0) (@Zero.toOfNat0 Real Real.instZero)) η)
              (@Filter.Eventually Nat
                (fun n =>
                  @LE.le Real Real.instLE
                    (@HMul.hMul Real Real Real (@instHMul Real Real.instMul)
                      (@HAdd.hAdd Real Real Real (@instHAdd Real Real.instAdd) α
                        (@HMul.hMul Real Real Real (@instHMul Real Real.instMul)
                          (@OfNat.ofNat Real (nat_lit 2) (@instOfNatAtLeastTwo Real (nat_lit 2) Real.instNatCast ⋯)) η))
                      (@Nat.cast Real Real.instNatCast n))
                    (@Nat.cast Real Real.instNatCast (@Finset.card (Fin n) (Luce.moderateReservoir w n d))))
                (@Filter.atTop Nat Nat.instPreorder)))
